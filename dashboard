        activeProjects: 3,
        projectHours: 48,
        completedProjects: 7,
        nextMeeting: 'Tomorrow'
      };
      
      document.getElementById('activeProjects').textContent = stats.activeProjects;
      document.getElementById('projectHours').textContent = stats.projectHours;
      document.getElementById('completedProjects').textContent = stats.completedProjects;
      document.getElementById('nextMeeting').textContent = stats.nextMeeting;
    }
    
    updateStats();
    
    // Simulate real-time updates (for demo)
    setInterval(() => {
      const hours = document.getElementById('projectHours');
      const currentHours = parseInt(hours.textContent);
      hours.textContent = currentHours + 1;
    }, 30000); // Every 30 seconds
    
    // Handle window resize
    window.addEventListener('resize', () => {
      if (window.innerWidth > 992 && sidebar.classList.contains('active')) {
        sidebar.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
    
    // Add active state to nav links
    document.querySelectorAll('.nav-links a').forEach(link => {
      link.addEventListener('click', function() {
        document.querySelectorAll('.nav-links a').forEach(l => l.classList.remove('active'));
        this.classList.add('active');
      });
    });
    
    // Initialize tooltips (simplified)
    document.querySelectorAll('.stat-card, .project-card, .action-card').forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.zIndex = '10';
      });
      
      card.addEventListener('mouseleave', function() {
        this.style.zIndex = '';
      });
    });
