<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Kreation Digital Hub Client Dashboard - Manage your projects, messages, and account settings" />
  <meta name="keywords" content="client dashboard, project management, Kreation Digital Hub, client portal" />
  <meta name="author" content="Kreation Digital Hub" />
  <title>Client Dashboard | Kreation Digital Hub</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Consistent with homepage CSS variables and base styles */
    :root {
      --primary: #003333;
      --secondary: #39FF14;
      --accent: #00CC99;
      --dark: #000000;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-start: #001a1a;
      --gradient-end: #004d4d;
      --neon-glow: 0 0 10px rgba(57, 255, 20, 0.7),
                   0 0 20px rgba(57, 255, 20, 0.5),
                   0 0 30px rgba(57, 255, 20, 0.3);
      --card-bg: rgba(0, 51, 51, 0.3);
      --sidebar-bg: rgba(0, 0, 0, 0.95);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      width: 100%;
      overflow-x: hidden;
    }

    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Montserrat', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .gradient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 50%, var(--gradient-end) 100%);
      opacity: 0.9;
      z-index: -3;
    }

    /* Dashboard Layout */
    .dashboard-container {
      display: flex;
      min-height: 100vh;
      width: 100%;
    }

    /* Sidebar */
    .dashboard-sidebar {
      width: 280px;
      background: var(--sidebar-bg);
      border-right: 1px solid rgba(57, 255, 20, 0.2);
      padding: 2rem 0;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
      z-index: 100;
      backdrop-filter: blur(10px);
      transition: transform 0.3s ease;
    }

    .sidebar-header {
      padding: 0 1.5rem 2rem;
      border-bottom: 1px solid rgba(57, 255, 20, 0.1);
      margin-bottom: 2rem;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--light);
      font-family: 'Montserrat', sans-serif;
      display: flex;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .logo span {
      color: var(--secondary);
      position: relative;
    }

    .logo span::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .user-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--secondary), var(--accent));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--dark);
      box-shadow: var(--neon-glow);
    }

    .user-details h3 {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.2rem;
    }

    .user-details p {
      color: var(--gray);
      font-size: 0.9rem;
    }

    .nav-links {
      list-style: none;
      padding: 0 1rem;
    }

    .nav-links li {
      margin-bottom: 0.5rem;
    }

    .nav-links a {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.5rem;
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      border-radius: 10px;
      transition: all 0.3s;
      font-weight: 500;
    }

    .nav-links a:hover,
    .nav-links a.active {
      background: rgba(57, 255, 20, 0.1);
      color: var(--secondary);
      border-left: 3px solid var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .nav-links i {
      font-size: 1.2rem;
      width: 24px;
      text-align: center;
    }

    .badge {
      background: var(--secondary);
      color: var(--dark);
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
      font-size: 0.8rem;
      font-weight: 700;
      margin-left: auto;
    }

    /* Main Content */
    .dashboard-main {
      flex: 1;
      margin-left: 280px;
      padding: 2rem;
      min-height: 100vh;
      position: relative;
    }

    /* Top Header */
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(57, 255, 20, 0.2);
    }

    .header-left h1 {
      font-size: 2.2rem;
      color: var(--light);
      font-weight: 700;
      font-family: 'Montserrat', sans-serif;
    }

    .header-left p {
      color: var(--gray);
      font-size: 1.1rem;
      margin-top: 0.5rem;
    }

    .header-right {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .notification-btn {
      position: relative;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.3rem;
      cursor: pointer;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s;
    }

    .notification-btn:hover {
      background: rgba(57, 255, 20, 0.1);
      color: var(--secondary);
    }

    .notification-badge {
      position: absolute;
      top: 5px;
      right: 5px;
      background: #ff4757;
      color: white;
      font-size: 0.7rem;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.5rem;
      cursor: pointer;
    }

    /* Stats Cards */
    .stats-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .stat-card {
      background: var(--card-bg);
      border-radius: 15px;
      padding: 1.5rem;
      border: 1px solid rgba(57, 255, 20, 0.2);
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .stat-card:hover {
      transform: translateY(-5px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }

    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, var(--secondary), var(--accent));
      transform-origin: left;
    }

    .stat-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      background: rgba(57, 255, 20, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: var(--secondary);
      margin-bottom: 1rem;
    }

    .stat-content h3 {
      font-size: 2rem;
      font-weight: 700;
      color: var(--light);
      margin-bottom: 0.5rem;
      font-family: 'Montserrat', sans-serif;
    }

    .stat-content p {
      color: var(--gray);
      font-size: 0.9rem;
    }

    .stat-trend {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
      font-size: 0.9rem;
    }

    .trend-up {
      color: var(--secondary);
    }

    .trend-down {
      color: #ff4757;
    }

    /* Main Content Sections */
    .content-section {
      margin-bottom: 3rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .section-header h2 {
      font-size: 1.8rem;
      color: var(--light);
      font-weight: 700;
      font-family: 'Montserrat', sans-serif;
    }

    .section-header h2 span {
      color: var(--secondary);
    }

    .section-header a {
      color: var(--secondary);
      text-decoration: none;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.3s;
    }

    .section-header a:hover {
      text-shadow: var(--neon-glow);
    }

    /* Projects Grid */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .project-card {
      background: var(--card-bg);
      border-radius: 15px;
      padding: 1.5rem;
      border: 1px solid rgba(57, 255, 20, 0.2);
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .project-card:hover {
      transform: translateY(-5px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1rem;
    }

    .project-title h3 {
      font-size: 1.3rem;
      color: var(--light);
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .project-status {
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .status-active {
      background: rgba(57, 255, 20, 0.2);
      color: var(--secondary);
    }

    .status-pending {
      background: rgba(255, 165, 0, 0.2);
      color: orange;
    }

    .status-completed {
      background: rgba(0, 204, 153, 0.2);
      color: var(--accent);
    }

    .project-description {
      color: var(--gray);
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .project-progress {
      margin-bottom: 1.5rem;
    }

    .progress-bar {
      height: 8px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 0.5rem;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--secondary), var(--accent));
      border-radius: 4px;
      transition: width 1s ease;
    }

    .progress-text {
      display: flex;
      justify-content: space-between;
      font-size: 0.9rem;
      color: var(--gray);
    }

    .project-actions {
      display: flex;
      gap: 1rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: var(--light);
      padding: 0.8rem 1.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.4s;
      border: 2px solid var(--secondary);
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
      font-size: 0.9rem;
      cursor: pointer;
      border: none;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: var(--secondary);
      transition: all 0.4s;
      z-index: -1;
    }

    .btn:hover {
      color: var(--dark);
      transform: translateY(-3px);
    }

    .btn:hover::before {
      width: 100%;
    }

    .btn i {
      margin-right: 0.5rem;
    }

    .btn-outline {
      background: transparent;
      color: var(--secondary);
      border: 2px solid var(--secondary);
    }

    .btn-outline:hover {
      color: var(--dark);
    }

    /* Messages Section */
    .messages-container {
      background: var(--card-bg);
      border-radius: 15px;
      border: 1px solid rgba(57, 255, 20, 0.2);
      overflow: hidden;
    }

    .message-item {
      display: flex;
      padding: 1.5rem;
      border-bottom: 1px solid rgba(57, 255, 20, 0.1);
      transition: all 0.3s;
      cursor: pointer;
    }

    .message-item:hover {
      background: rgba(57, 255, 20, 0.05);
    }

    .message-item.unread {
      background: rgba(57, 255, 20, 0.1);
    }

    .message-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--secondary), var(--accent));
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: var(--dark);
      margin-right: 1rem;
      flex-shrink: 0;
    }

    .message-content {
      flex: 1;
    }

    .message-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
    }

    .message-sender {
      font-weight: 600;
      color: var(--light);
    }

    .message-time {
      color: var(--gray);
      font-size: 0.9rem;
    }

    .message-preview {
      color: var(--gray);
      font-size: 0.95rem;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Quick Actions */
    .quick-actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
    }

    .action-card {
      background: var(--card-bg);
      border-radius: 15px;
      padding: 2rem;
      border: 1px solid rgba(57, 255, 20, 0.2);
      text-align: center;
      transition: all 0.3s;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
    }

    .action-card:hover {
      transform: translateY(-5px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }

    .action-icon {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: rgba(57, 255, 20, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      color: var(--secondary);
      margin: 0 auto 1.5rem;
      box-shadow: var(--neon-glow);
    }

    .action-card h3 {
      font-size: 1.3rem;
      color: var(--light);
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    .action-card p {
      color: var(--gray);
      font-size: 0.9rem;
      line-height: 1.4;
    }

    /* Footer */
    .dashboard-footer {
      text-align: center;
      padding: 2rem;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.9rem;
      border-top: 1px solid rgba(57, 255, 20, 0.1);
      margin-top: 3rem;
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
      .dashboard-sidebar {
        width: 250px;
      }
      
      .dashboard-main {
        margin-left: 250px;
      }
    }

    @media (max-width: 992px) {
      .dashboard-sidebar {
        transform: translateX(-100%);
        width: 280px;
      }
      
      .dashboard-sidebar.active {
        transform: translateX(0);
      }
      
      .dashboard-main {
        margin-left: 0;
        padding: 1.5rem;
      }
      
      .mobile-menu-btn {
        display: block;
      }
      
      .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        z-index: 99;
        display: none;
      }
      
      .overlay.active {
        display: block;
      }
    }

    @media (max-width: 768px) {
      .stats-cards {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .projects-grid {
        grid-template-columns: 1fr;
      }
      
      .quick-actions {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .header-left h1 {
        font-size: 1.8rem;
      }
    }

    @media (max-width: 576px) {
      .stats-cards {
        grid-template-columns: 1fr;
      }
      
      .quick-actions {
        grid-template-columns: 1fr;
      }
      
      .project-actions {
        flex-direction: column;
      }
      
      .header-right {
        flex-direction: column;
        gap: 0.5rem;
      }
      
      .dashboard-main {
        padding: 1rem;
      }
    }

    /* Animations */
    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.05); }
      100% { transform: scale(1); }
    }

    .pulse {
      animation: pulse 2s infinite;
    }
  </style>
</head>
<body>
  <div id="particles-js"></div>
  <div class="gradient-bg"></div>
  
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="dashboard-sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="logo">Kreation <span>Digital</span>Hub</div>
        <div class="user-info">
          <div class="user-avatar" id="userAvatar">JD</div>
          <div class="user-details">
            <h3 id="userName">John Doe</h3>
            <p id="userEmail">john@example.com</p>
          </div>
        </div>
      </div>
      
      <ul class="nav-links">
        <li><a href="home" class="active"><i class="fas fa-home"></i> Homepage</a></li>
        <li><a href="#" class="active"><i class="fas fa-home"></i> Dashboard</a></li>
        <li><a href="#"><i class="fas fa-project-diagram"></i> My Projects</a></li>
        <li><a href="chats"><i class="fas fa-comments"></i> Messages <span class="badge">3</span></a></li>
        <li><a href="reviews"><i class="fas fa-star"></i> Leave Review</a></li>
        <li><a href="home#book-call"><i class="fas fa-calendar-alt"></i> Schedule</a></li>
        <li><a href="#"><i class="fas fa-cog"></i> Settings</a></li>
        <li><a href="#" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
      </ul>
    </aside>
    
    <div class="overlay" id="overlay"></div>
    
    <!-- Main Content -->
    <main class="dashboard-main">
      <!-- Top Header -->
      <header class="dashboard-header">
        <div class="header-left">
          <h1>Client Dashboard</h1>
          <p>Welcome back! Here's what's happening with your projects.</p>
        </div>
        <div class="header-right">
          <button class="notification-btn">
            <i class="fas fa-bell"></i>
            <span class="notification-badge">3</span>
          </button>
          <button class="mobile-menu-btn" id="mobileMenuBtn">
            <i class="fas fa-bars"></i>
          </button>
        </div>
      </header>
      
      <!-- Stats Cards -->
      <div class="stats-cards">
        <div class="stat-card" data-aos="fade-up">
          <div class="stat-icon">
            <i class="fas fa-project-diagram"></i>
          </div>
          <div class="stat-content">
            <h3 id="activeProjects">3</h3>
            <p>Active Projects</p>
            <div class="stat-trend trend-up">
              <i class="fas fa-arrow-up"></i>
              <span>1 new this week</span>
            </div>
          </div>
        </div>
        
        <div class="stat-card" data-aos="fade-up" data-aos-delay="100">
          <div class="stat-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="stat-content">
            <h3 id="projectHours">48</h3>
            <p>Hours This Month</p>
            <div class="stat-trend trend-up">
              <i class="fas fa-arrow-up"></i>
              <span>12% from last month</span>
            </div>
          </div>
        </div>
        
        <div class="stat-card" data-aos="fade-up" data-aos-delay="200">
          <div class="stat-icon">
            <i class="fas fa-check-circle"></i>
          </div>
          <div class="stat-content">
            <h3 id="completedProjects">7</h3>
            <p>Projects Completed</p>
            <div class="stat-trend trend-up">
              <i class="fas fa-arrow-up"></i>
              <span>2 completed this month</span>
            </div>
          </div>
        </div>
        
        <div class="stat-card" data-aos="fade-up" data-aos-delay="300">
          <div class="stat-icon">
            <i class="fas fa-calendar-check"></i>
          </div>
          <div class="stat-content">
            <h3 id="nextMeeting">Tomorrow</h3>
            <p>Next Meeting</p>
            <div class="stat-trend">
              <i class="fas fa-clock"></i>
              <span>10:00 AM</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Active Projects Section -->
      <section class="content-section">
        <div class="section-header">
          <h2>Active <span>Projects</span></h2>
          <a href="#"><i class="fas fa-plus"></i> New Project</a>
        </div>
        
        <div class="projects-grid">
          <div class="project-card" data-aos="fade-up">
            <div class="project-header">
              <div class="project-title">
                <h3>E-commerce Website</h3>
                <p>EGVL Store</p>
              </div>
              <span class="project-status status-active">In Progress</span>
            </div>
            <p class="project-description">Modern e-commerce platform with payment integration and inventory management.</p>
            <div class="project-progress">
              <div class="progress-bar">
                <div class="progress-fill" style="width: 75%"></div>
