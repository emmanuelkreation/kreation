<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Kreation Digital Hub: Professional Google Business Profile optimization portfolio showcasing local SEO success, review management, and GBP performance." />
  <meta name="keywords" content="google business profile, GBP optimization, local SEO, google maps, review management, local marketing" />
  <meta name="author" content="Kreation Digital Hub" />
  <title>Google Business Portfolio | Kreation Digital Hub</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* =============================================
       COMPLETE CSS FROM YOUR HOMEPAGE
       ============================================= */
    
    :root {
      --primary: #003333;
      --secondary: #39FF14;
      --accent: #00CC99;
      --dark: #000000;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-start: #001a1a;
      --gradient-end: #004d4d;
      --neon-glow: 0 0 10px rgba(57, 255, 20, 0.7),
                   0 0 20px rgba(57, 255, 20, 0.5),
                   0 0 30px rgba(57, 255, 20, 0.3);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
      position: relative;
    }

    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Montserrat', sans-serif;
      position: relative;
      width: 100%;
      min-height: 100vh;
    }

    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .gradient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 50%, var(--gradient-end) 100%);
      opacity: 0.9;
      z-index: -3;
    }

    /* Header & Navigation */
    header {
      background: rgba(0, 0, 0, 0.95);
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(57, 255, 20, 0.2);
      transition: all 0.3s ease;
      width: 100%;
      left: 0;
      right: 0;
    }

    header.scrolled {
      padding: 0.8rem 2rem;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--light);
      font-family: 'Montserrat', sans-serif;
      display: flex;
      align-items: center;
      z-index: 1002;
    }

    .logo span {
      color: var(--secondary);
      position: relative;
    }

    .logo span::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    /* Dropdown Menu */
    .dropdown {
      position: relative;
    }

    .dropdown > a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .dropdown-content {
      position: absolute;
      top: 100%;
      left: 0;
      background: rgba(0, 0, 0, 0.98);
      min-width: 220px;
      border: 1px solid rgba(57, 255, 20, 0.2);
      border-radius: 10px;
      padding: 1rem 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all 0.3s ease;
      z-index: 1000;
      backdrop-filter: blur(10px);
    }

    .dropdown:hover .dropdown-content {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .dropdown-content a {
      display: block;
      padding: 0.8rem 1.5rem;
      color: var(--light);
      text-decoration: none;
      transition: all 0.3s;
      border-left: 3px solid transparent;
    }

    .dropdown-content a:hover {
      color: var(--secondary);
      background: rgba(57, 255, 20, 0.1);
      border-left-color: var(--secondary);
      padding-left: 2rem;
    }

    .dropdown-content a.active {
      color: var(--secondary);
      border-left-color: var(--secondary);
      background: rgba(57, 255, 20, 0.05);
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      color: var(--light);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      position: relative;
      padding: 0.5rem 0;
      font-family: 'Montserrat', sans-serif;
      letter-spacing: 0.5px;
      font-size: 0.95rem;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--secondary);
      transition: width 0.3s;
      box-shadow: var(--neon-glow);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 1001;
    }

    /* Hero Section */
    .hero {
      padding: 8rem 2rem 5rem;
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    .hero-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 3rem;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .hero-text {
      flex: 1;
      position: relative;
      z-index: 2;
    }

    .hero-text h1 {
      font-size: 3.8rem;
      line-height: 1.2;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .hero-text h1 span {
      color: var(--secondary);
      display: block;
      text-shadow: var(--neon-glow);
      position: relative;
    }

    .hero-text p {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
      max-width: 600px;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 400;
    }

    .btn-group {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: var(--light);
      padding: 1rem 2.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.4s;
      border: 2px solid var(--secondary);
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: var(--secondary);
      transition: all 0.4s;
      z-index: -1;
    }

    .btn:hover {
      color: var(--dark);
      transform: translateY(-5px);
    }

    .btn:hover::before {
      width: 100%;
    }

    .btn-secondary {
      background: transparent;
      color: var(--secondary);
    }

    .btn-secondary:hover {
      color: var(--dark);
    }

    .hero-image {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .hero-image-container {
      width: 380px;
      height: 380px;
      position: relative;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid var(--secondary);
      box-shadow: var(--neon-glow);
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
      100% { transform: translateY(0px); }
    }

    .hero-image-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .tech-element {
      position: absolute;
      width: 100px;
      height: 100px;
      border: 2px solid rgba(57, 255, 20, 0.5);
      border-radius: 10px;
      box-shadow: var(--neon-glow);
      animation: rotate 20s linear infinite;
      z-index: -1;
    }

    .tech-element-1 {
      top: 20%;
      left: 10%;
      width: 120px;
      height: 120px;
      animation-duration: 25s;
    }

    .tech-element-2 {
      bottom: 30%;
      right: 15%;
      width: 80px;
      height: 80px;
      animation-duration: 15s;
      animation-direction: reverse;
    }

    @keyframes rotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Sections */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .section {
      padding: 8rem 0;
      position: relative;
    }

    .section-title {
      text-align: center;
      margin-bottom: 5rem;
    }

    .section-title h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .section-title h2 span {
      color: var(--secondary);
    }

    .section-title h2::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 4px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .section-title p {
      max-width: 700px;
      margin: 2rem auto 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
      line-height: 1.6;
    }

    /* Card Styles */
    .card {
      background: rgba(0, 51, 51, 0.3);
      border-radius: 15px;
      padding: 2.5rem;
      transition: all 0.4s;
      height: 100%;
      border: 1px solid rgba(57, 255, 20, 0.2);
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, var(--secondary), var(--accent));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s;
    }

    .card:hover {
      transform: translateY(-10px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    }

    .card:hover::before {
      transform: scaleX(1);
    }

    /* Grid Layouts */
    .grid {
      display: grid;
      gap: 2.5rem;
    }

    .grid-3 {
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    }

    .grid-4 {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    /* Footer */
    footer {
      background: rgba(0, 0, 0, 0.95);
      padding: 5rem 0 2rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 3rem;
      margin-bottom: 4rem;
    }

    .footer-col h4 {
      color: var(--light);
      margin-bottom: 1.5rem;
      font-size: 1.4rem;
      position: relative;
      padding-bottom: 0.8rem;
      font-weight: 700;
    }

    .footer-col h4::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 50px;
      height: 3px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      transition: all 0.3s;
      font-size: 1.1rem;
    }

    .footer-links a:hover {
      color: var(--secondary);
      transform: translateX(5px);
    }

    .social-links {
      display: flex;
      gap: 1.2rem;
      margin-top: 1.5rem;
    }

    .social-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--light);
      transition: all 0.3s;
      font-size: 1.2rem;
    }

    .social-links a:hover {
      background: var(--secondary);
      color: var(--dark);
      transform: translateY(-5px);
      box-shadow: var(--neon-glow);
    }

    .copyright {
      text-align: center;
      padding-top: 3rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.1rem;
    }

    /* Scroll to top button */
    #scrollTopBtn {
      position: fixed;
      bottom: 40px;
      right: 40px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
      opacity: 0;
      visibility: hidden;
      z-index: 1000;
      box-shadow: var(--neon-glow);
      border: none;
    }

    #scrollTopBtn.show {
      opacity: 1;
      visibility: visible;
    }

    #scrollTopBtn:hover {
      transform: translateY(-5px) scale(1.1);
    }

    /* Chat Widget */
    .chat-widget {
      position: fixed;
      bottom: 30px;
      right: 30px;
      z-index: 999;
    }

    .chat-button {
      background: var(--secondary);
      color: var(--dark);
      border: none;
      border-radius: 50px;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      cursor: pointer;
      font-weight: 600;
      box-shadow: var(--neon-glow);
      transition: all 0.3s;
      font-size: 1rem;
      white-space: nowrap;
    }

    .chat-button:hover {
      transform: translateY(-5px);
    }

    /* =============================================
       GOOGLE BUSINESS PORTFOLIO PAGE
       ============================================= */
    
    /* Google Business Hero */
    .gmb-hero {
      padding: 8rem 2rem 4rem;
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, rgba(0, 51, 51, 0.9) 0%, rgba(0, 0, 0, 0.95) 100%);
    }
    
    .gmb-hero-content {
      max-width: 800px;
      z-index: 2;
      position: relative;
    }
    
    .gmb-hero h1 {
      font-size: 3.8rem;
      line-height: 1.2;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }
    
    .gmb-hero h1 span {
      color: var(--secondary);
      display: inline-block;
      text-shadow: var(--neon-glow);
      position: relative;
    }
    
    .gmb-hero p {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 400;
      line-height: 1.6;
    }
    
    /* Google Business Categories */
    .gmb-categories {
      padding: 3rem 2rem;
      background: rgba(0, 0, 0, 0.5);
    }
    
    .gmb-tabs {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 4rem;
    }
    
    .gmb-tab {
      background: transparent;
      color: var(--light);
      border: 1px solid var(--gray);
      padding: 1rem 2.5rem;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s;
      font-family: 'Montserrat', sans-serif;
      font-weight: 500;
      font-size: 1rem;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }
    
    .gmb-tab.active,
    .gmb-tab:hover {
      background: var(--secondary);
      color: var(--dark);
      border-color: var(--secondary);
      box-shadow: var(--neon-glow);
      transform: translateY(-2px);
    }
    
    .gmb-tab i {
      font-size: 1.2rem;
    }
    
    /* Google Business Portfolio */
    .gmb-portfolio-section {
      padding: 5rem 2rem;
      background: var(--dark);
      position: relative;
    }
    
    .gmb-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
      gap: 2.5rem;
      max-width: 1400px;
      margin: 0 auto;
    }
    
    /* Google Business Item */
    .gmb-item {
      border-radius: 15px;
      overflow: hidden;
      position: relative;
      background: rgba(0, 51, 51, 0.2);
      border: 1px solid rgba(57, 255, 20, 0.1);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      height: 500px;
    }
    
    .gmb-item:hover {
      transform: translateY(-10px);
      border-color: var(--secondary);
      box-shadow: 
        0 20px 40px rgba(0, 0, 0, 0.5),
        var(--neon-glow);
    }
    
    .gmb-img-container {
      width: 100%;
      height: 250px;
      position: relative;
      overflow: hidden;
    }
    
    .gmb-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .gmb-item:hover .gmb-img {
      transform: scale(1.05);
    }
    
    .gmb-content {
      padding: 2rem;
      height: 250px;
      display: flex;
      flex-direction: column;
    }
    
    .gmb-badges {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    
    .gmb-badge {
      background: rgba(57, 255, 20, 0.1);
      color: var(--secondary);
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      border: 1px solid var(--secondary);
    }
    
    .gmb-title {
      color: var(--light);
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      font-family: 'Montserrat', sans-serif;
    }
    
    .gmb-description {
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
      flex-grow: 1;
      font-family: 'Inter', sans-serif;
    }
    
    .gmb-metrics {
      display: flex;
      justify-content: space-between;
      margin-top: auto;
    }
    
    .gmb-metric {
      text-align: center;
    }
    
    .metric-number {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--secondary);
      margin-bottom: 0.3rem;
    }
    
    .metric-label {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    /* Google Business Stats */
    .gmb-stats {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
      margin: 5rem auto;
      max-width: 800px;
      padding: 2rem;
      background: rgba(0, 51, 51, 0.2);
      border-radius: 15px;
      border: 1px solid rgba(57, 255, 20, 0.2);
      backdrop-filter: blur(10px);
    }
    
    .gmb-stat-item {
      text-align: center;
      padding: 1rem 2rem;
    }
    
    .gmb-stat-number {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--secondary);
      margin-bottom: 0.5rem;
      text-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
    }
    
    .gmb-stat-label {
      color: var(--light);
      font-size: 1rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    /* Google Business Process */
    .gmb-process {
      padding: 6rem 2rem;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 100%);
    }
    
    .process-steps {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 2rem;
      margin-top: 4rem;
    }
    
    .process-step {
      flex: 1;
      min-width: 200px;
      text-align: center;
      padding: 2rem 1rem;
      position: relative;
    }
    
    .process-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -1rem;
      transform: translateY(-50%);
      width: 2rem;
      height: 2px;
      background: var(--secondary);
      opacity: 0.5;
    }
    
    .step-icon {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: var(--secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      margin: 0 auto 1.5rem;
      box-shadow: var(--neon-glow);
    }
    
    .step-title {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--light);
    }
    
    .step-description {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1rem;
    }
    
    /* Google Business Services */
