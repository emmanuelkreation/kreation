<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Kreation Digital Hub: Professional website design, persuasive copywriting, and Google Business Profile optimization for entrepreneurs, SMEs, and real estate firms." />
  <meta name="keywords" content="web design Nigeria, copywriting services, Google Business Profile optimization, digital marketing agency, professional website development" />
  <meta name="author" content="Kreation Digital Hub" />
  <title>Kreation Digital Hub | Professional Web Design, Copywriting & Google Business Profile Services</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="icon" href="favicon.jpg" type="image/jg">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #003333;
      --secondary: #39FF14;
      --accent: #00CC99;
      --dark: #000000;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-start: #001a1a;
      --gradient-end: #004d4d;
      --neon-glow: 0 0 10px rgba(57, 255, 20, 0.7),
                   0 0 20px rgba(57, 255, 20, 0.5),
                   0 0 30px rgba(57, 255, 20, 0.3);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
      position: relative;
    }

    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Montserrat', sans-serif;
      position: relative;
      width: 100%;
      min-height: 100vh;
    }

    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .gradient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 50%, var(--gradient-end) 100%);
      opacity: 0.9;
      z-index: -3;
    }

    /* Header & Navigation */
    header {
      background: rgba(0, 0, 0, 0.95);
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(57, 255, 20, 0.2);
      transition: all 0.3s ease;
      width: 100%;
      left: 0;
      right: 0;
    }

    header.scrolled {
      padding: 0.8rem 2rem;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--light);
      font-family: 'Montserrat', sans-serif;
      display: flex;
      align-items: center;
      z-index: 1002;
    }

    .logo span {
      color: var(--secondary);
      position: relative;
    }

    .logo span::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--light);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      position: relative;
      padding: 0.5rem 0;
      font-family: 'Montserrat', sans-serif;
      letter-spacing: 0.5px;
      font-size: 0.95rem;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--secondary);
      transition: width 0.3s;
      box-shadow: var(--neon-glow);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 1001;
    }

    /* Hero Section */
    .hero {
      padding: 8rem 2rem 5rem;
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    .hero-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 3rem;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .hero-text {
      flex: 1;
      position: relative;
      z-index: 2;
    }

    .hero-text h1 {
      font-size: 3.8rem;
      line-height: 1.2;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .hero-text h1 span {
      color: var(--secondary);
      display: block;
      text-shadow: var(--neon-glow);
      position: relative;
    }

    .hero-text p {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
      max-width: 600px;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 400;
    }

    .btn-group {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: var(--light);
      padding: 1rem 2.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.4s;
      border: 2px solid var(--secondary);
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: var(--secondary);
      transition: all 0.4s;
      z-index: -1;
    }

    .btn:hover {
      color: var(--dark);
      transform: translateY(-5px);
    }

    .btn:hover::before {
      width: 100%;
    }

    .btn-secondary {
      background: transparent;
      color: var(--secondary);
    }

    .btn-secondary:hover {
      color: var(--dark);
    }

    .hero-image {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .hero-image-container {
      width: 380px;
      height: 380px;
      position: relative;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid var(--secondary);
      box-shadow: var(--neon-glow);
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
      100% { transform: translateY(0px); }
    }

    .hero-image-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .tech-element {
      position: absolute;
      width: 100px;
      height: 100px;
      border: 2px solid rgba(57, 255, 20, 0.5);
      border-radius: 10px;
      box-shadow: var(--neon-glow);
      animation: rotate 20s linear infinite;
      z-index: -1;
    }

    .tech-element-1 {
      top: 20%;
      left: 10%;
      width: 120px;
      height: 120px;
      animation-duration: 25s;
    }

    .tech-element-2 {
      bottom: 30%;
      right: 15%;
      width: 80px;
      height: 80px;
      animation-duration: 15s;
      animation-direction: reverse;
    }

    @keyframes rotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Trusted By Section */
    .trusted-by {
      padding: 3rem 0;
      background: rgba(0, 0, 0, 0.5);
      text-align: center;
    }

    .trusted-by p {
      color: var(--gray);
      margin-bottom: 1.5rem;
      font-size: 1.1rem;
    }

    .client-logos {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .client-logo {
      color: var(--gray);
      font-weight: 600;
      font-size: 1.2rem;
      opacity: 0.7;
      transition: all 0.3s;
    }

    .client-logo:hover {
      opacity: 1;
      color: var(--secondary);
    }

    /* Sections */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .section {
      padding: 8rem 0;
      position: relative;
    }

    .section-title {
      text-align: center;
      margin-bottom: 5rem;
    }

    .section-title h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .section-title h2 span {
      color: var(--secondary);
    }

    .section-title h2::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 4px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .section-title p {
      max-width: 700px;
      margin: 2rem auto 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
      line-height: 1.6;
    }

    /* Process Section */
    .process-steps {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 2rem;
      margin-top: 4rem;
    }

    .process-step {
      flex: 1;
      min-width: 200px;
      text-align: center;
      padding: 2rem 1rem;
      position: relative;
    }

    .process-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -1rem;
      transform: translateY(-50%);
      width: 2rem;
      height: 2px;
      background: var(--secondary);
      opacity: 0.5;
    }

    .step-number {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 700;
      margin: 0 auto 1.5rem;
      box-shadow: var(--neon-glow);
    }

    .step-title {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--light);
    }

    .step-description {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1rem;
    }

    /* Card Styles */
    .card {
      background: rgba(0, 51, 51, 0.3);
      border-radius: 15px;
      padding: 2.5rem;
      transition: all 0.4s;
      height: 100%;
      border: 1px solid rgba(57, 255, 20, 0.2);
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, var(--secondary), var(--accent));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s;
    }

    .card:hover {
      transform: translateY(-10px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    }

    .card:hover::before {
      transform: scaleX(1);
    }

    /* Grid Layouts */
    .grid {
      display: grid;
      gap: 2.5rem;
    }

    .grid-3 {
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    }

    .grid-4 {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    /* About Sections */
    .about-content {
      display: flex;
      gap: 4rem;
      align-items: center;
    }

    .about-img {
      flex: 1;
      position: relative;
      display: flex;
      justify-content: center;
    }

    .about-img img {
      width: 100%;
      max-width: 450px;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      transition: all 0.4s;
    }

    .about-img:hover img {
      transform: scale(1.03);
    }

    .about-text {
      flex: 1;
    }

    .about-text h3 {
      font-size: 2.2rem;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 700;
    }

    .about-text p {
      margin-bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.8;
      font-size: 1.1rem;
    }

    /* Services Section */
    .service-card {
      text-align: center;
      position: relative;
    }

    .service-icon {
      font-size: 3.5rem;
      color: var(--secondary);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
    }

    .service-icon::after {
      content: '';
      position: absolute;
      width: 60px;
      height: 60px;
      background: rgba(57, 255, 20, 0.1);
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: -1;
    }

    .service-card h3 {
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 700;
    }

    .service-card p {
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    .service-card ul {
      text-align: left;
      padding-left: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
    }

    .service-card li {
      margin-bottom: 0.8rem;
      position: relative;
    }

    .service-card li::before {
      content: '▹';
      color: var(--secondary);
      position: absolute;
      left: -1.5rem;
    }

    /* Portfolio Section */
    .portfolio-filter {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 4rem;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: transparent;
      color: var(--light);
      border: 1px solid var(--gray);
      padding: 0.8rem 2rem;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s;
      font-family: 'Montserrat', sans-serif;
      font-weight: 500;
    }

    .filter-btn.active,
    .filter-btn:hover {
      background: var(--secondary);
      color: var(--dark);
      border-color: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .portfolio-item {
      border-radius: 15px;
      overflow: hidden;
      position: relative;
      height: 300px;
    }

    .portfolio-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s;
    }

    .portfolio-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.95);
      padding: 2rem;
      transform: translateY(100%);
      transition: transform 0.5s;
      backdrop-filter: blur(5px);
    }

    .portfolio-item:hover .portfolio-overlay {
      transform: translateY(0);
    }

    .portfolio-item:hover .portfolio-img {
      transform: scale(1.1);
    }

    .portfolio-overlay h3 {
      color: var(--light);
      margin-bottom: 0.8rem;
      font-size: 1.5rem;
    }

    .portfolio-overlay p {
      color: var(--gray);
      margin-bottom: 1.5rem;
    }

    /* Testimonials */
    .testimonial-card {
      display: flex;
      align-items: center;
      gap: 2rem;
      padding: 2.5rem;
    }

    .testimonial-img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid var(--secondary);
      box-shadow: var(--neon-glow);
      flex-shrink: 0;
    }

    .testimonial-content blockquote {
      font-style: italic;
      margin-bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
      position: relative;
      padding-left: 2rem;
      font-size: 1.1rem;
      line-height: 1.7;
    }

    .testimonial-content blockquote::before {
      content: '"';
      position: absolute;
      left: 0;
      top: -15px;
      font-size: 4rem;
      color: var(--secondary);
      opacity: 0.3;
    }

    .testimonial-author {
      font-weight: 700;
      color: var(--light);
      font-size: 1.1rem;
    }

    .testimonial-role {
      color: var(--secondary);
      font-size: 0.9rem;
    }

    /* Stats Section */
    .stats-section {
      background: linear-gradient(135deg, rgba(0, 51, 51, 0.7) 0%, rgba(0, 0, 0, 0.9) 100%);
      padding: 6rem 0;
      text-align: center;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 3rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .stat-item {
      padding: 2rem;
    }

    .stat-number {
      font-size: 3.5rem;
      font-weight: 800;
      color: var(--secondary);
      margin-bottom: 1rem;
      text-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
    }

    .stat-label {
      color: var(--light);
      font-size: 1.2rem;
      font-weight: 500;
    }

    /* Booking Section */
    .booking-section {
      background: rgba(0, 0, 0, 0.8);
      padding: 6rem 0;
      text-align: center;
    }

    .booking-frame {
      max-width: 1000px;
      margin: 0 auto;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    /* FAQ Section */
    .faq-section {
      background: rgba(0, 0, 0, 0.5);
    }

    .faq-container {
      max-width: 900px;
      margin: 0 auto;
    }

    .faq-item {
      margin-bottom: 1.5rem;
      border-radius: 10px;
      overflow: hidden;
      background: rgba(0, 51, 51, 0.3);
      border: 1px solid rgba(57, 255, 20, 0.2);
    }

    .faq-question {
      padding: 1.5rem;
      background: rgba(0, 0, 0, 0.3);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      font-size: 1.1rem;
      transition: all 0.3s;
    }

    .faq-question:hover {
      background: rgba(0, 0, 0, 0.5);
    }

    .faq-question i {
      transition: transform 0.3s;
    }

    .faq-answer {
      padding: 0 1.5rem;
      max-height: 0;
      overflow: hidden;
      transition: all 0.3s ease-out;
    }

    .faq-item.active .faq-answer {
      padding: 1.5rem;
      max-height: 500px;
    }

    .faq-item.active .faq-question i {
      transform: rotate(180deg);
    }

    /* Contact Section */
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 4rem;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .contact-item {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
    }

    .contact-icon {
      font-size: 1.8rem;
      color: var(--secondary);
      min-width: 50px;
      text-shadow: var(--neon-glow);
    }

    .contact-text h4 {
      color: var(--light);
      margin-bottom: 0.5rem;
      font-size: 1.3rem;
    }

    .contact-text p, .contact-text a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      transition: color 0.3s;
      font-size: 1.1rem;
    }

    .contact-text a:hover {
      color: var(--secondary);
    }

    .contact-form .form-group {
      margin-bottom: 2rem;
    }

    .form-control {
      width: 100%;
      padding: 1.2rem 1.5rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(57, 255, 20, 0.3);
      border-radius: 8px;
      color: var(--light);
      font-family: inherit;
      font-size: 1.1rem;
      transition: all 0.3s;
    }

    .form-control:focus {
      border-color: var(--secondary);
      outline: none;
      box-shadow: 0 0 15px rgba(57, 255, 20, 0.3);
      background: rgba(255, 255, 255, 0.08);
    }

    textarea.form-control {
      min-height: 180px;
      resize: vertical;
    }

    /* Footer */
    footer {
      background: rgba(0, 0, 0, 0.95);
      padding: 5rem 0 2rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 3rem;
      margin-bottom: 4rem;
    }

    .footer-col h4 {
      color: var(--light);
      margin-bottom: 1.5rem;
      font-size: 1.4rem;
      position: relative;
      padding-bottom: 0.8rem;
      font-weight: 700;
    }

    .footer-col h4::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 50px;
      height: 3px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      transition: all 0.3s;
      font-size: 1.1rem;
    }

    .footer-links a:hover {
      color: var(--secondary);
      transform: translateX(5px);
    }

    .social-links {
      display: flex;
      gap: 1.2rem;
      margin-top: 1.5rem;
    }

    .social-links a {
