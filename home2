<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Kreation Digital Hub: Award-winning website design, persuasive copywriting, and Google Business Profile optimization for entrepreneurs, SMEs, and real estate firms." />
  <meta name="keywords" content="professional web design Nigeria, conversion copywriting services, Google Business Profile experts, digital marketing agency Lagos, premium website development" />
  <meta name="author" content="Kreation Digital Hub" />
  <title>Kreation Digital Hub | Award-Winning Digital Agency for Web Design, Copywriting & SEO</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="icon" href="favicon.jpg" type="image/jg">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #003333;
      --secondary: #00FF88;
      --accent: #7B61FF;
      --dark: #0A0A0A;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-primary: linear-gradient(135deg, #001a1a 0%, #004d4d 100%);
      --gradient-secondary: linear-gradient(135deg, #00FF88 0%, #7B61FF 100%);
      --gradient-dark: linear-gradient(135deg, #0A0A0A 0%, #1A1A1A 100%);
      --neon-glow: 0 0 20px rgba(0, 255, 136, 0.7),
                   0 0 40px rgba(0, 255, 136, 0.5),
                   0 0 60px rgba(0, 255, 136, 0.3);
      --accent-glow: 0 0 20px rgba(123, 97, 255, 0.7);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
      position: relative;
    }

    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Space Grotesk', 'Montserrat', sans-serif;
      position: relative;
      width: 100%;
      min-height: 100vh;
    }

    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .gradient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--gradient-dark);
      opacity: 0.95;
      z-index: -3;
    }

    /* Header & Navigation - Enhanced */
    header {
      background: rgba(10, 10, 10, 0.95);
      padding: 1.2rem 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0, 255, 136, 0.1);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      width: 100%;
    }

    header.scrolled {
      padding: 0.8rem 5%;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      background: rgba(10, 10, 10, 0.98);
    }

    .logo {
      font-size: 2rem;
      font-weight: 900;
      color: var(--light);
      font-family: 'Space Grotesk', sans-serif;
      display: flex;
      align-items: center;
      z-index: 1002;
      letter-spacing: -0.5px;
    }

    .logo span {
      background: var(--gradient-secondary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
      font-weight: 900;
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      color: var(--light);
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
      position: relative;
      padding: 0.5rem 0;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      letter-spacing: 0.3px;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--secondary);
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--gradient-secondary);
      transition: width 0.3s;
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }

    .nav-cta {
      background: var(--gradient-secondary);
      color: var(--dark);
      padding: 0.8rem 1.8rem;
      border-radius: 50px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.3s;
      margin-left: 1rem;
      border: none;
      font-family: 'Space Grotesk', sans-serif;
    }

    .nav-cta:hover {
      transform: translateY(-2px);
      box-shadow: var(--neon-glow);
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 1001;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s;
    }

    .mobile-menu-btn:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    /* Hero Section - Enhanced */
    .hero {
      padding: 12rem 5% 8rem;
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      align-items: center;
    }

    .hero-text {
      position: relative;
      z-index: 2;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      background: rgba(0, 255, 136, 0.1);
      border: 1px solid rgba(0, 255, 136, 0.3);
      border-radius: 50px;
      padding: 0.6rem 1.5rem;
      margin-bottom: 2rem;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--secondary);
      backdrop-filter: blur(10px);
    }

    .hero-badge i {
      margin-right: 0.5rem;
    }

    .hero-text h1 {
      font-size: 4.2rem;
      line-height: 1.1;
      margin-bottom: 1.8rem;
      color: var(--light);
      font-weight: 900;
      font-family: 'Space Grotesk', sans-serif;
      letter-spacing: -1px;
    }

    .hero-text h1 span {
      background: var(--gradient-secondary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      display: inline;
      position: relative;
    }

    .hero-text p {
      font-size: 1.4rem;
      margin-bottom: 3rem;
      max-width: 600px;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 400;
      line-height: 1.7;
    }

    .btn-group {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--gradient-secondary);
      color: var(--dark);
      padding: 1.2rem 3rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 700;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border: none;
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.1rem;
      letter-spacing: 0.5px;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #7B61FF 0%, #00FF88 100%);
      opacity: 0;
      transition: opacity 0.4s;
      z-index: -1;
    }

    .btn:hover {
      transform: translateY(-5px) scale(1.05);
      box-shadow: 0 20px 40px rgba(0, 255, 136, 0.4);
    }

    .btn:hover::before {
      opacity: 1;
    }

    .btn-secondary {
      background: transparent;
      color: var(--secondary);
      border: 2px solid var(--secondary);
      backdrop-filter: blur(10px);
    }

    .btn-secondary:hover {
      background: var(--secondary);
      color: var(--dark);
    }

    .hero-stats {
      display: flex;
      gap: 3rem;
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .stat {
      display: flex;
      flex-direction: column;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--secondary);
      font-family: 'Space Grotesk', sans-serif;
    }

    .stat-label {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-visual-container {
      width: 420px;
      height: 420px;
      position: relative;
      border-radius: 30px;
      overflow: hidden;
      border: 3px solid transparent;
      background: var(--gradient-primary);
      box-shadow: var(--neon-glow), 0 30px 60px rgba(0, 0, 0, 0.5);
      animation: float 8s ease-in-out infinite;
      transform-style: preserve-3d;
      perspective: 1000px;
    }

    .hero-visual-container::before {
      content: '';
      position: absolute;
      inset: -2px;
      background: var(--gradient-secondary);
      border-radius: inherit;
      z-index: -1;
      animation: rotate 20s linear infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotateX(0deg) rotateY(0deg); }
      50% { transform: translateY(-30px) rotateX(5deg) rotateY(5deg); }
    }

    @keyframes rotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .hero-visual-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: relative;
      z-index: 1;
      border-radius: inherit;
    }

    .floating-elements {
      position: absolute;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .floating-element {
      position: absolute;
      width: 80px;
      height: 80px;
      background: rgba(123, 97, 255, 0.1);
      border: 1px solid rgba(123, 97, 255, 0.3);
      border-radius: 15px;
      backdrop-filter: blur(10px);
      animation: float-element 15s ease-in-out infinite;
    }

    @keyframes float-element {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(20px, -20px) rotate(90deg); }
      50% { transform: translate(-15px, 15px) rotate(180deg); }
      75% { transform: translate(10px, -10px) rotate(270deg); }
    }

    /* Trusted By Section - Enhanced */
    .trusted-by {
      padding: 5rem 5%;
      background: rgba(10, 10, 10, 0.8);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .trusted-by::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--secondary), transparent);
    }

    .trusted-by h3 {
      font-size: 1.1rem;
      color: var(--secondary);
      margin-bottom: 2rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
    }

    .client-logos {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4rem;
      flex-wrap: wrap;
      max-width: 1200px;
      margin: 0 auto;
    }

    .client-logo {
      font-size: 1.4rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.8);
      transition: all 0.3s;
      position: relative;
      padding: 1rem 2rem;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 15px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      min-width: 180px;
      text-align: center;
    }

    .client-logo:hover {
      color: var(--secondary);
      border-color: rgba(0, 255, 136, 0.3);
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }

    /* Enhanced Sections */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 5%;
    }

    .section {
      padding: 10rem 0;
      position: relative;
    }

    .section-title {
      text-align: center;
      margin-bottom: 6rem;
    }

    .section-title h2 {
      font-size: 3.5rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      font-weight: 900;
      font-family: 'Space Grotesk', sans-serif;
      letter-spacing: -1px;
    }

    .section-title h2 span {
      background: var(--gradient-secondary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .section-title h2::after {
      content: '';
      position: absolute;
      bottom: -20px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 4px;
      background: var(--gradient-secondary);
      border-radius: 2px;
    }

    .section-title p {
      max-width: 700px;
      margin: 3rem auto 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.3rem;
      line-height: 1.7;
    }

    /* Value Proposition Section */
    .value-prop-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 3rem;
      margin-top: 5rem;
    }

    .value-prop-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      padding: 3rem;
      transition: all 0.4s;
      position: relative;
      overflow: hidden;
    }

    .value-prop-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--gradient-secondary);
      opacity: 0;
      transition: opacity 0.4s;
      z-index: -1;
    }

    .value-prop-card:hover {
      transform: translateY(-10px);
      border-color: rgba(0, 255, 136, 0.3);
    }

    .value-prop-card:hover::before {
      opacity: 0.1;
    }

    .value-prop-icon {
      font-size: 3rem;
      color: var(--secondary);
      margin-bottom: 2rem;
      display: inline-block;
    }

    .value-prop-card h3 {
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 700;
    }

    .value-prop-card p {
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    /* Services Section - Enhanced */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 3rem;
      margin-top: 5rem;
    }

    .service-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      padding: 3rem;
      transition: all 0.4s;
      position: relative;
      overflow: hidden;
      height: 100%;
    }

    .service-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: var(--gradient-secondary);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s;
    }

    .service-card:hover {
      transform: translateY(-10px);
      border-color: rgba(0, 255, 136, 0.3);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .service-card:hover::before {
      transform: scaleX(1);
    }

    .service-icon {
      font-size: 3.5rem;
      margin-bottom: 2rem;
      display: inline-block;
      background: var(--gradient-secondary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .service-card h3 {
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 700;
    }

    .service-card p {
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.7;
      margin-bottom: 2rem;
    }

    .service-features {
      list-style: none;
      margin-bottom: 2rem;
    }

    .service-features li {
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 0.8rem;
      padding-left: 1.5rem;
      position: relative;
    }

    .service-features li::before {
      content: '▸';
      color: var(--secondary);
      position: absolute;
      left: 0;
      font-weight: bold;
    }

    .service-cta {
      display: inline-flex;
      align-items: center;
      color: var(--secondary);
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
    }

    .service-cta:hover {
      transform: translateX(5px);
    }

    .service-cta i {
      margin-left: 0.5rem;
      transition: transform 0.3s;
    }

    .service-cta:hover i {
      transform: translateX(5px);
    }

    /* Process Section - Enhanced */
    .process-timeline {
      display: flex;
      justify-content: space-between;
      position: relative;
      margin-top: 5rem;
      flex-wrap: wrap;
      gap: 2rem;
    }

    .process-timeline::before {
      content: '';
      position: absolute;
      top: 60px;
      left: 0;
      right: 0;
      height: 2px;
      background: rgba(255, 255, 255, 0.1);
      z-index: 1;
    }

    .process-step {
      flex: 1;
      min-width: 200px;
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .step-circle {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: var(--gradient-secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 900;
      margin: 0 auto 2rem;
      box-shadow: var(--neon-glow);
      position: relative;
      border: 5px solid var(--dark);
    }

    .step-content {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 15px;
      padding: 2rem;
      transition: all 0.3s;
    }

    .process-step:hover .step-content {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(0, 255, 136, 0.2);
    }

    .step-title {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--light);
    }

    .step-description {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1rem;
      line-height: 1.6;
    }

    /* Portfolio Section - Enhanced */
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
      gap: 2.5rem;
      margin-top: 5rem;
    }

    .portfolio-item {
      border-radius: 20px;
      overflow: hidden;
      position: relative;
      height: 400px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .portfolio-item:hover .portfolio-img {
      transform: scale(1.1);
    }

    .portfolio-item:hover .portfolio-overlay {
      opacity: 1;
      transform: translateY(0);
    }

    .portfolio-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .portfolio-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(to top, rgba(10, 10, 10, 0.95), transparent);
      padding: 3rem;
      transform: translateY(20px);
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .portfolio-overlay h3 {
      font-size: 1.8rem;
      margin-bottom: 0.8rem;
      color: var(--light);
    }

    .portfolio-overlay p {
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 1.5rem;
      font-size: 1.1rem;
    }

    .portfolio-tags {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .portfolio-tag {
      background: rgba(0, 255, 136, 0.1);
      color: var(--secondary);
      padding: 0.4rem 1rem;
      border-radius: 50px;
      font-size: 0.9rem;
      font-weight: 600;
    }

    /* Testimonials - Enhanced */
    .testimonials-slider {
      position: relative;
      margin-top: 5rem;
      overflow: hidden;
    }

    .testimonial-slide {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      padding: 3rem;
      transition: all 0.4s;
    }

    .testimonial-header {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .testimonial-avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid var(--secondary);
    }

    .testimonial-info h4 {
      font-size: 1.3rem;
      color: var(--light);
      margin-bottom: 0.3rem;
    }

    .testimonial-info p {
      color: var(--secondary);
      font-size: 0.9rem;
      font-weight: 600;
    }

    .testimonial-quote {
      font-size: 1.2rem;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.9);
      font-style: italic;
      margin-bottom: 2rem;
      position: relative;
      padding-left: 2rem;
    }

    .testimonial-quote::before {
      content: '"';
      position: absolute;
      left: 0;
      top: -10px;
      font-size: 3rem;
      color: var(--secondary);
      opacity: 0.3;
    }

    .testimonial-stats {
