<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Transparent pricing for professional website design, copywriting, and Google Business Profile optimization services. Get the perfect package for your business needs." />
  <meta name="keywords" content="web design pricing Nigeria, copywriting services cost, Google Business Profile pricing, affordable website development" />
  <meta name="author" content="Kreation Digital Hub" />
  <title>Pricing | Kreation Digital Hub | Professional Web Design & Digital Marketing Services</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <link rel="icon" href="favicon.jpg" type="image/jg">
  <style>
    :root {
      --primary: #003333;
      --secondary: #39FF14;
      --accent: #00CC99;
      --dark: #000000;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-start: #001a1a;
      --gradient-end: #004d4d;
      --neon-glow: 0 0 10px rgba(57, 255, 20, 0.7),
                   0 0 20px rgba(57, 255, 20, 0.5),
                   0 0 30px rgba(57, 255, 20, 0.3);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
      position: relative;
    }

    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Montserrat', sans-serif;
      position: relative;
      width: 100%;
      min-height: 100vh;
    }

    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .gradient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 50%, var(--gradient-end) 100%);
      opacity: 0.9;
      z-index: -3;
    }

    /* Header & Navigation */
    header {
      background: rgba(0, 0, 0, 0.95);
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(57, 255, 20, 0.2);
      transition: all 0.3s ease;
      width: 100%;
      left: 0;
      right: 0;
    }

    header.scrolled {
      padding: 0.8rem 2rem;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--light);
      font-family: 'Montserrat', sans-serif;
      display: flex;
      align-items: center;
      z-index: 1002;
    }

    .logo span {
      color: var(--secondary);
      position: relative;
    }

    .logo span::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--light);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      position: relative;
      padding: 0.5rem 0;
      font-family: 'Montserrat', sans-serif;
      letter-spacing: 0.5px;
      font-size: 0.95rem;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--secondary);
      transition: width 0.3s;
      box-shadow: var(--neon-glow);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 1001;
    }

    /* Hero Section */
    .hero {
      padding: 8rem 2rem 5rem;
      min-height: 50vh;
      display: flex;
      align-items: center;
      background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), 
                  url('https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80');
      background-size: cover;
      background-position: center;
      text-align: center;
      position: relative;
      width: 100%;
    }

    .hero-content {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .hero h1 {
      font-size: 3.5rem;
      line-height: 1.2;
      margin-bottom: 1rem;
      color: var(--light);
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .hero h1 span {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .hero p {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
      color: rgba(255, 255, 255, 0.9);
    }

    .btn-group {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: var(--light);
      padding: 1rem 2.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.4s;
      border: 2px solid var(--secondary);
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: var(--secondary);
      transition: all 0.4s;
      z-index: -1;
    }

    .btn:hover {
      color: var(--dark);
      transform: translateY(-5px);
    }

    .btn:hover::before {
      width: 100%;
    }

    .btn-secondary {
      background: transparent;
      color: var(--secondary);
    }

    .btn-secondary:hover {
      color: var(--dark);
    }

    /* Sections */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .section {
      padding: 6rem 0;
      position: relative;
    }

    .section-title {
      text-align: center;
      margin-bottom: 5rem;
    }

    .section-title h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .section-title h2 span {
      color: var(--secondary);
    }

    .section-title h2::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 4px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .section-title p {
      max-width: 700px;
      margin: 2rem auto 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
      line-height: 1.6;
    }

    /* Pricing Grid */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      margin-top: 3rem;
    }

    .price-card {
      background: rgba(0, 51, 51, 0.3);
      border-radius: 15px;
      padding: 2.5rem 2rem;
      text-align: center;
      transition: all 0.4s;
      border: 1px solid rgba(57, 255, 20, 0.2);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      backdrop-filter: blur(10px);
      height: 100%;
    }

    .price-card:hover {
      transform: translateY(-10px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    }

    .price-card.featured {
      border-color: var(--secondary);
      transform: scale(1.05);
      z-index: 1;
      box-shadow: 0 0 30px rgba(57, 255, 20, 0.4);
    }

    .price-card.featured::before {
      content: 'MOST POPULAR';
      position: absolute;
      top: 20px;
      right: -35px;
      background: var(--secondary);
      color: var(--dark);
      padding: 8px 40px;
      transform: rotate(45deg);
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 1px;
    }

    .price-card h3 {
      font-size: 1.8rem;
      margin-bottom: 1rem;
      color: var(--light);
      font-weight: 700;
    }

    .price-tag {
      font-size: 3rem;
      font-weight: 800;
      color: var(--secondary);
      margin: 1.5rem 0;
      text-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
    }

    .price-tag span {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 400;
    }

    .price-card ul {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0;
      text-align: left;
      flex-grow: 1;
    }

    .price-card li {
      padding: 0.8rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      gap: 0.8rem;
      color: rgba(255, 255, 255, 0.9);
    }

    .price-card li:last-child {
      border-bottom: none;
    }

    .price-card li i {
      color: var(--secondary);
      min-width: 24px;
      text-shadow: var(--neon-glow);
    }

    .btn-outline {
      background: transparent;
      color: var(--secondary);
      border: 2px solid var(--secondary);
    }

    .btn-outline:hover {
      color: var(--dark);
    }

    /* Service Comparison */
    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 3rem;
      background: rgba(0, 51, 51, 0.3);
      border-radius: 15px;
      overflow: hidden;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(57, 255, 20, 0.2);
    }

    .comparison-table th, 
    .comparison-table td {
      padding: 1.5rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.9);
    }

    .comparison-table th {
      background: rgba(57, 255, 20, 0.1);
      color: var(--secondary);
      font-weight: 600;
      font-size: 1.1rem;
    }

    .comparison-table tr:last-child td {
      border-bottom: none;
    }

    .comparison-table td i.fa-check {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .comparison-table td i.fa-times {
      color: #ff6b6b;
    }

    /* Value Proposition */
    .value-props {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin: 4rem 0;
    }

    .value-prop {
      text-align: center;
      padding: 2rem;
      background: rgba(0, 51, 51, 0.3);
      border-radius: 15px;
      border: 1px solid rgba(57, 255, 20, 0.2);
      backdrop-filter: blur(10px);
    }

    .value-icon {
      font-size: 3rem;
      color: var(--secondary);
      margin-bottom: 1.5rem;
      text-shadow: var(--neon-glow);
    }

    .value-prop h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--light);
      font-weight: 700;
    }

    .value-prop p {
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.6;
    }

    /* CTA Section */
    .cta-section {
      background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), 
                  url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80');
      background-size: cover;
      background-position: center;
      padding: 6rem 2rem;
      text-align: center;
      border-radius: 15px;
      position: relative;
      overflow: hidden;
    }

    .cta-section h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .cta-section p {
      max-width: 700px;
      margin: 0 auto 2rem;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
    }

    /* FAQ Section */
    .faq-container {
      max-width: 900px;
      margin: 0 auto;
    }

    .faq-item {
      margin-bottom: 1.5rem;
      border-radius: 10px;
      overflow: hidden;
      background: rgba(0, 51, 51, 0.3);
      border: 1px solid rgba(57, 255, 20, 0.2);
      backdrop-filter: blur(10px);
    }

    .faq-question {
      padding: 1.5rem;
      background: rgba(57, 255, 20, 0.1);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      transition: background 0.3s;
      color: var(--light);
      font-size: 1.1rem;
    }

    .faq-question:hover {
      background: rgba(57, 255, 20, 0.2);
    }

    .faq-question i {
      transition: transform 0.3s;
      color: var(--secondary);
    }

    .faq-answer {
      padding: 0 1.5rem;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s, padding 0.3s;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.7;
    }

    .faq-item.active .faq-answer {
      padding: 1.5rem;
      max-height: 500px;
    }

    .faq-item.active .faq-question i {
      transform: rotate(180deg);
    }

    /* Footer */
    footer {
      background: rgba(0, 0, 0, 0.95);
      padding: 5rem 0 2rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 3rem;
      margin-bottom: 4rem;
    }

    .footer-col h4 {
      color: var(--light);
      margin-bottom: 1.5rem;
      font-size: 1.4rem;
      position: relative;
      padding-bottom: 0.8rem;
      font-weight: 700;
    }

    .footer-col h4::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 50px;
      height: 3px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      transition: all 0.3s;
      font-size: 1.1rem;
    }

    .footer-links a:hover {
      color: var(--secondary);
      transform: translateX(5px);
    }

    .social-links {
      display: flex;
      gap: 1.2rem;
      margin-top: 1.5rem;
    }

    .social-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--light);
      transition: all 0.3s;
      font-size: 1.2rem;
    }

    .social-links a:hover {
      background: var(--secondary);
      color: var(--dark);
      transform: translateY(-5px);
      box-shadow: var(--neon-glow);
    }

    .copyright {
      text-align: center;
      padding-top: 3rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.1rem;
    }

    /* Scroll to top button */
    #scrollTopBtn {
      position: fixed;
      bottom: 40px;
      right: 40px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
      opacity: 0;
      visibility: hidden;
      z-index: 1000;
      box-shadow: var(--neon-glow);
      border: none;
    }

    #scrollTopBtn.show {
      opacity: 1;
      visibility: visible;
    }

    #scrollTopBtn:hover {
      transform: translateY(-5px) scale(1.1);
    }

    .floating-cta {
      position: fixed;
      bottom: 110px;
      right: 30px;
      background: var(--secondary);
      color: var(--dark);
      padding: 0.8rem 1.5rem;
      border-radius: 50px;
      font-weight: 600;
      cursor: pointer;
      z-index: 999;
      box-shadow: var(--neon-glow);
      text-decoration: none;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'Montserrat', sans-serif;
    }

    .floating-cta:hover {
      background: var(--primary);
      color: var(--secondary);
      transform: translateY(-5px);
    }

    /* Chat Widget */
    .chat-widget {
      position: fixed;
      bottom: 30px;
      right: 30px;
      z-index: 999;
    }

    .chat-button {
      background: var(--secondary);
      color: var(--dark);
      border: none;
      border-radius: 50px;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      cursor: pointer;
      font-weight: 600;
      box-shadow: var(--neon-glow);
      transition: all 0.3s;
      font-size: 1rem;
      white-space: nowrap;
    }

    .chat-button:hover {
      transform: translateY(-5px);
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
      .hero h1 {
        font-size: 3rem;
      }
    }

    @media (max-width: 992px) {
      .hero {
        padding: 7rem 2rem 4rem;
      }
      
      .section {
        padding: 5rem 0;
      }
      
      .price-card.featured {
        transform: scale(1);
      }
      
      .comparison-table {
        display: block;
        overflow-x: auto;
      }
      
      .mobile-menu-btn {
        display: block;
      }
      
      .nav-links {
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        background: rgba(0, 0, 0, 0.98);
        flex-direction: column;
        padding: 5rem 2rem 2rem;
        transition: right 0.3s ease;
        z-index: 999;
        box-shadow: -5px 0 15px rgba(0, 0, 0, 0.5);
        margin: 0;
      }
      
      .nav-links.active {
        right: 0;
      }
      
      .nav-links a {
        font-size: 1.2rem;
        padding: 1rem 0;
        display: block;
        border-bottom: 1px solid rgba(57, 255, 20, 0.1);
      }
      
      .nav-links::before {
        content: '\f00d';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        top: 1.5rem;
        right: 2rem;
        font-size: 1.5rem;
        color: var(--light);
        cursor: pointer;
        z-index: 1001;
      }

      body.menu-open {
        overflow: hidden;
      }
    }

    @media (max-width: 768px) {
      .nav-links {
        gap: 1rem;
      }

      .hero h1 {
        font-size: 2.5rem;
      }
      
      .hero p {
        font-size: 1.1rem;
      }

      .section {
        padding: 4rem 0;
      }
      
      .price-card {
        padding: 2rem 1.5rem;
      }
      
      .pricing-grid {
        grid-template-columns: 1fr;
      }
      
      .chat-button span {
        display: none;
      }
      
      .chat-button {
        padding: 1rem;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        justify-content: center;
      }

      .container {
        padding: 0 1rem;
      }
    }

    @media (max-width: 576px) {
      header {
        padding: 1rem;
      }
      
      header.scrolled {
        padding: 0.8rem 1rem;
      }

      .nav-links {
        width: 100%;
        gap: 0.8rem;
      }

      .hero {
        padding: 6rem 1rem 3rem;
      }

      .hero h1 {
        font-size: 2.2rem;
      }
      
      .section-title h2 {
        font-size: 2.2rem;
      }
      
      .footer-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      
      .footer-col h4::after {
        left: 50%;
        transform: translateX(-50%);
      }
      
      .social-links {
        justify-content: center;
      }
      
      .floating-cta {
        bottom: 100px;
        right: 20px;
        padding: 0.6rem 1.2rem;
        font-size: 0.9rem;
      }
      
      #scrollTopBtn {
        bottom: 90px;
        right: 20px;
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
      }
      
      .chat-widget {
        bottom: 20px;
        right: 20px;
      }
      
      .chat-button {
        padding: 0.8rem;
        width: 55px;
        height: 55px;
      }

      .container {
        padding: 0 1rem;
        max-width: 100%;
        overflow: hidden;
      }
    }

    @media (max-width: 480px) {
      html {
