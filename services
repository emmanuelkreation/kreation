    closeMatcher.addEventListener('click', () => {
      matcherOverlay.classList.remove('active');
      document.body.style.overflow = '';
    });
    matcherOverlay.addEventListener('click', (e) => {
      if (e.target === matcherOverlay) {
        matcherOverlay.classList.remove('active');
        document.body.style.overflow = '';
      }
    });

    nextBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (matcherCurrentStep < matcherTotalSteps) {
          const stepDiv = matcherSteps[matcherCurrentStep - 1];
          const required = stepDiv.querySelectorAll('[required]');
          let valid = true;
          required.forEach(field => {
            if (field.value.trim() === '') { field.style.borderColor = 'red'; valid = false; } 
            else { field.style.borderColor = ''; }
          });
          if (!valid) { alert('Please fill in all required fields (marked with *).'); return; }
          showMatcherStep(matcherCurrentStep + 1);
        }
      });
    });

    prevBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (matcherCurrentStep > 1) showMatcherStep(matcherCurrentStep - 1);
      });
    });

