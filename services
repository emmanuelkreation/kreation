<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Professional website design, conversion copywriting, and Google Business Profile optimization services. Transform your digital presence with Kreation Digital Hub." />
  <meta name="keywords" content="web design services Nigeria, professional copywriting, Google Business Profile optimization, website development, digital marketing services" />
  <meta name="author" content="Kreation Digital Hub" />
  <title>Services | Kreation Digital Hub | Professional Web Design & Digital Marketing Solutions</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <link rel="icon" href="favicon.jpg" type="image/jpg">
  <style>
    :root {
      --primary: #003333;
      --secondary: #39FF14;
      --accent: #00CC99;
      --dark: #000000;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-start: #001a1a;
      --gradient-end: #004d4d;
      --neon-glow: 0 0 10px rgba(57, 255, 20, 0.7),
                   0 0 20px rgba(57, 255, 20, 0.5),
                   0 0 30px rgba(57, 255, 20, 0.3);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
      position: relative;
    }

    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Montserrat', sans-serif;
      position: relative;
      width: 100%;
      min-height: 100vh;
    }

    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .gradient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 50%, var(--gradient-end) 100%);
      opacity: 0.9;
      z-index: -3;
    }

    /* Header & Navigation */
    header {
      background: rgba(0, 0, 0, 0.95);
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(57, 255, 20, 0.2);
      transition: all 0.3s ease;
      width: 100%;
      left: 0;
      right: 0;
    }

    header.scrolled {
      padding: 0.8rem 2rem;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--light);
      font-family: 'Montserrat', sans-serif;
      display: flex;
      align-items: center;
      z-index: 1002;
    }

    .logo span {
      color: var(--secondary);
      position: relative;
    }

    .logo span::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--light);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      position: relative;
      padding: 0.5rem 0;
      font-family: 'Montserrat', sans-serif;
      letter-spacing: 0.5px;
      font-size: 0.95rem;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--secondary);
      transition: width 0.3s;
      box-shadow: var(--neon-glow);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 1001;
    }

    /* Hero Section */
    .hero {
      padding: 8rem 2rem 5rem;
      min-height: 50vh;
      display: flex;
      align-items: center;
      background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), 
                  url('https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80');
      background-size: cover;
      background-position: center;
      text-align: center;
      position: relative;
      width: 100%;
    }

    .hero-content {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .hero h1 {
      font-size: 3.5rem;
      line-height: 1.2;
      margin-bottom: 1rem;
      color: var(--light);
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .hero h1 span {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .hero p {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
      color: rgba(255, 255, 255, 0.9);
    }

    .btn-group {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: var(--light);
      padding: 1rem 2.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.4s;
      border: 2px solid var(--secondary);
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
      cursor: pointer;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: var(--secondary);
      transition: all 0.4s;
      z-index: -1;
    }

    .btn:hover {
      color: var(--dark);
      transform: translateY(-5px);
    }

    .btn:hover::before {
      width: 100%;
    }

    .btn-secondary {
      background: transparent;
      color: var(--secondary);
    }

    .btn-secondary:hover {
      color: var(--dark);
    }

    /* Sections */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .section {
      padding: 6rem 0;
      position: relative;
    }

    .section-title {
      text-align: center;
      margin-bottom: 5rem;
    }

    .section-title h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .section-title h2 span {
      color: var(--secondary);
    }

    .section-title h2::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 4px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .section-title p {
      max-width: 700px;
      margin: 2rem auto 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
      line-height: 1.6;
    }

    /* Card Styles */
    .card {
      background: rgba(0, 51, 51, 0.3);
      border-radius: 15px;
      padding: 2.5rem;
      transition: all 0.4s;
      height: 100%;
      border: 1px solid rgba(57, 255, 20, 0.2);
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, var(--secondary), var(--accent));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s;
    }

    .card:hover {
      transform: translateY(-10px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    }

    .card:hover::before {
      transform: scaleX(1);
    }

    .card .btn {
      margin-top: auto;
      align-self: center;
    }

    /* Grid Layouts */
    .grid {
      display: grid;
      gap: 2.5rem;
    }

    .grid-3 {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }

    .grid-4 {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    /* Service Cards (shortened) */
    .service-card {
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .service-icon {
      font-size: 3.5rem;
      color: var(--secondary);
      margin-bottom: 1.5rem;
      transition: transform 0.3s;
      text-shadow: var(--neon-glow);
      position: relative;
    }

    .service-icon::after {
      content: '';
      position: absolute;
      width: 60px;
      height: 60px;
      background: rgba(57, 255, 20, 0.1);
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: -1;
    }

    .service-card:hover .service-icon {
      transform: scale(1.2);
    }

    .service-card h3 {
      font-size: 1.6rem;
      margin-bottom: 0.8rem;
      color: var(--light);
      font-weight: 700;
    }

    .service-card .short-desc {
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 1.5rem;
      line-height: 1.6;
      flex-grow: 1;
    }

    /* Process Section */
    .process-steps {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 2rem;
      margin-top: 4rem;
    }

    .process-step {
      flex: 1;
      min-width: 200px;
      text-align: center;
      padding: 2rem 1rem;
      position: relative;
    }

    .process-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -1rem;
      transform: translateY(-50%);
      width: 2rem;
      height: 2px;
      background: var(--secondary);
      opacity: 0.5;
    }

    .step-number {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 700;
      margin: 0 auto 1.5rem;
      box-shadow: var(--neon-glow);
    }

    .step-title {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--light);
    }

    .step-description {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1rem;
    }

    /* CTA Section */
    .cta-section {
      background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), 
                  url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80');
      background-size: cover;
      background-position: center;
      padding: 6rem 2rem;
      text-align: center;
      border-radius: 15px;
      position: relative;
      overflow: hidden;
    }

    .cta-section h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .cta-section p {
      max-width: 700px;
      margin: 0 auto 2rem;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
    }

    /* Footer */
    footer {
      background: rgba(0, 0, 0, 0.95);
      padding: 5rem 0 2rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 3rem;
      margin-bottom: 4rem;
    }

    .footer-col h4 {
      color: var(--light);
      margin-bottom: 1.5rem;
      font-size: 1.4rem;
      position: relative;
      padding-bottom: 0.8rem;
      font-weight: 700;
    }

    .footer-col h4::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 50px;
      height: 3px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      transition: all 0.3s;
      font-size: 1.1rem;
    }

    .footer-links a:hover {
      color: var(--secondary);
      transform: translateX(5px);
    }

    .social-links {
      display: flex;
      gap: 1.2rem;
      margin-top: 1.5rem;
    }

    .social-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--light);
      transition: all 0.3s;
      font-size: 1.2rem;
    }

    .social-links a:hover {
      background: var(--secondary);
      color: var(--dark);
      transform: translateY(-5px);
      box-shadow: var(--neon-glow);
    }

    .copyright {
      text-align: center;
      padding-top: 3rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.1rem;
    }

    /* Scroll to top button */
    #scrollTopBtn {
      position: fixed;
      bottom: 40px;
      right: 40px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
      opacity: 0;
      visibility: hidden;
      z-index: 1000;
      box-shadow: var(--neon-glow);
      border: none;
    }

    #scrollTopBtn.show {
      opacity: 1;
      visibility: visible;
    }

    #scrollTopBtn:hover {
      transform: translateY(-5px) scale(1.1);
    }

    .floating-cta {
      position: fixed;
      bottom: 110px;
      right: 30px;
      background: var(--secondary);
      color: var(--dark);
      padding: 0.8rem 1.5rem;
      border-radius: 50px;
      font-weight: 600;
      cursor: pointer;
      z-index: 999;
      box-shadow: var(--neon-glow);
      text-decoration: none;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .floating-cta:hover {
      background: var(--primary);
      color: var(--secondary);
      transform: translateY(-5px);
    }

    /* Chat Widget (Tawk) */
    .chat-widget {
      position: fixed;
      bottom: 30px;
      right: 30px;
      z-index: 999;
    }

    .chat-button {
      background: var(--secondary);
      color: var(--dark);
      border: none;
      border-radius: 50px;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      cursor: pointer;
      font-weight: 600;
      box-shadow: var(--neon-glow);
      transition: all 0.3s;
      font-size: 1rem;
      white-space: nowrap;
    }

    .chat-button:hover {
      transform: translateY(-5px);
    }

    /* ========================================================= */
    /* NEW: Service Detail Modal, Order Modal, Matcher Modal      */
    /* ========================================================= */

    /* Shared Modal Overlay */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.88);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      backdrop-filter: blur(8px);
      padding: 20px;
      box-sizing: border-box;
      overflow-y: auto;
    }
    .modal-overlay.active { display: flex; }

    .modal-box {
      background: #0a1a1a;
      border: 1px solid var(--secondary);
      border-radius: 20px;
      max-width: 800px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      padding: 40px 35px;
      position: relative;
      box-shadow: 0 20px 60px rgba(0,0,0,0.8);
    }
    .modal-box::-webkit-scrollbar { width: 6px; }
    .modal-box::-webkit-scrollbar-thumb { background: var(--secondary); border-radius: 10px; }

    .modal-close {
      position: sticky;
      top: 0;
      float: right;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 28px;
      cursor: pointer;
      transition: 0.3s;
      z-index: 10;
    }
    .modal-close:hover { color: var(--secondary); transform: rotate(90deg); }

    .modal-box h2 {
      color: var(--secondary);
      font-family: 'Montserrat', sans-serif;
      font-weight: 700;
      margin-bottom: 10px;
      font-size: 2rem;
    }
    .modal-box .subtitle {
      color: rgba(255,255,255,0.7);
      margin-bottom: 25px;
      font-size: 1.1rem;
    }

    /* Service Detail specific */
    .detail-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 20px 40px;
      background: rgba(0,51,51,0.3);
      padding: 15px 20px;
      border-radius: 12px;
      margin: 15px 0 20px;
      border: 1px solid rgba(57,255,20,0.15);
    }
    .detail-meta span { color: rgba(255,255,255,0.8); }
    .detail-meta strong { color: var(--secondary); }

    .detail-features {
      list-style: none;
      padding: 0;
      margin: 15px 0 25px;
    }
    .detail-features li {
      padding: 8px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      color: rgba(255,255,255,0.9);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .detail-features li::before {
      content: "▹";
      color: var(--secondary);
      font-size: 1.2rem;
    }

    .detail-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 25px;
    }

    /* Order Modal */
    .order-summary {
      background: rgba(0,51,51,0.2);
      padding: 15px 20px;
      border-radius: 10px;
      border-left: 4px solid var(--secondary);
      margin: 15px 0 20px;
    }
    .order-summary .timeline-display {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--secondary);
    }

    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: var(--light);
    }
    .form-group label .required { color: var(--secondary); margin-left: 3px; }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 12px 15px;
      border-radius: 10px;
      border: 1px solid rgba(57,255,20,0.3);
      background: rgba(255,255,255,0.05);
      color: var(--light);
      font-size: 1rem;
      transition: 0.3s;
      font-family: inherit;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
      outline: none;
      border-color: var(--secondary);
      box-shadow: 0 0 15px rgba(57,255,20,0.2);
    }
    .form-group select option { background: #0a1a1a; color: #fff; }
    .form-group textarea { min-height: 80px; resize: vertical; }

    /* Matcher Modal (re-used styles from earlier) */
    .matcher-step { display: none; animation: fadeIn 0.4s ease; }
    .matcher-step.active { display: block; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .checkbox-group { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 5px; }
    .checkbox-group label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 400;
      color: rgba(255,255,255,0.9);
      cursor: pointer;
    }
    .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--secondary); }
    .step-buttons {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
      gap: 15px;
      flex-wrap: wrap;
    }
    .step-buttons .btn { min-width: 120px; }

    .proposal-box {
      background: rgba(0,51,51,0.3);
      border-radius: 15px;
      padding: 30px;
      border: 1px solid rgba(57,255,20,0.3);
      margin-top: 20px;
    }
    .proposal-box h3 {
      color: var(--secondary);
      font-size: 1.6rem;
      border-bottom: 2px solid var(--secondary);
      padding-bottom: 10px;
      margin-bottom: 20px;
    }
    .proposal-item {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .proposal-item .label { color: rgba(255,255,255,0.7); }
    .proposal-item .value { font-weight: 600; color: var(--light); }
    .proposal-total {
      background: rgba(57,255,20,0.1);
      padding: 15px 20px;
      border-radius: 10px;
      margin-top: 15px;
      display: flex;
