    const prevBtns = document.querySelectorAll('.prevStep');
    let matcherCurrentStep = 1;
    const matcherTotalSteps = matcherSteps.length;

    function showMatcherStep(step) {
      matcherSteps.forEach((el, idx) => el.classList.toggle('active', idx === step - 1));
      matcherCurrentStep = step;
      document.querySelector('.modal-box').scrollTop = 0;
    }

    openMatcherBtn.addEventListener('click', () => {
      matcherOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      showMatcherStep(1);
      document.getElementById('proposalResult').style.display = 'none';
      document.getElementById('matcherForm').style.display = 'block';
