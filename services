    matcherForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const finalStep = matcherSteps[matcherTotalSteps - 1];
      const required = finalStep.querySelectorAll('[required]');
      let valid = true;
      required.forEach(field => {
        if (field.value.trim() === '') { field.style.borderColor = 'red'; valid = false; } 
        else { field.style.borderColor = ''; }
      });
      if (!valid) { alert('Please fill in all required fields.'); return; }

      const data = {
        bizName: document.getElementById('bizName').value,
        industry: document.getElementById('industry').value,
        bizAge: document.getElementById('bizAge').value,
        bizSize: document.getElementById('bizSize').value,
        goals: Array.from(document.querySelectorAll('#goalsGroup input:checked')).map(cb => cb.value),
        audience: document.getElementById('audience').value,
        existingSite: document.getElementById('existingSite').value,
        cms: document.getElementById('cms').value,
        ecommerce: document.getElementById('ecommerce').value,
        productCount: document.getElementById('productCount').value,
        booking: document.getElementById('booking').value,
        userAccounts: document.getElementById('userAccounts').value,
        integrations: document.getElementById('integrations').value,
        styleGuide: document.getElementById('styleGuide').value,
        pages: document.getElementById('pages').value,
        copywriting: document.getElementById('copywriting').value,
        graphics: document.getElementById('graphics').value,
        timeline: document.getElementById('timeline').value,
        maintenance: document.getElementById('maintenance').value,
        budget: document.getElementById('budget').value,
        flexible: document.getElementById('flexible').value,
        specific: document.getElementById('specificFeatures').value,
        referral: document.getElementById('referral').value,
      };

      const proposal = generateProposal(data);
      displayProposal(proposal);
    });

    function generateProposal(data) {
      let scopeItems = [];
      let pageCount = data.pages;
      let pageDesc = pageCount === '1-3' ? 'Starter (1‑3 pages)' :
                     pageCount === '4-7' ? 'Standard (4‑7 pages)' :
                     pageCount === '8-12' ? 'Advanced (8‑12 pages)' : 'Enterprise (13+ pages)';
      scopeItems.push(`📄 ${pageDesc}`);
      if (data.cms === 'yes') scopeItems.push('🛠️ Content Management System (CMS)');
      if (data.ecommerce === 'yes') {
        scopeItems.push('🛒 E‑commerce functionality');
        if (data.productCount) scopeItems.push(`   • ${data.productCount} products estimated`);
      }
      if (data.booking === 'yes') scopeItems.push('📅 Booking / Appointment system');
      if (data.userAccounts === 'yes') scopeItems.push('👤 User accounts / login');
      if (data.integrations === 'yes') scopeItems.push('🔗 Third‑party integrations');
      if (data.copywriting === 'yes') scopeItems.push('✍️ Professional copywriting');
      if (data.graphics === 'yes') scopeItems.push('🎨 Custom graphics / photography');
      if (data.styleGuide === 'no') scopeItems.push('🎯 Brand identity development');

      let timelineWeeks = { 'asap': '1‑2 weeks', 'month': '3‑4 weeks', '3months': '6‑8 weeks', 'flexible': '8‑12 weeks' };
      let timelineText = timelineWeeks[data.timeline] || 'flexible';
      if (scopeItems.length > 6) {
        if (data.timeline === 'asap') timelineText = '2‑3 weeks';
        else if (data.timeline === 'month') timelineText = '4‑6 weeks';
        else if (data.timeline === '3months') timelineText = '8‑10 weeks';
        else timelineText = '10‑14 weeks';
      }

      let budgetRange = {
        '<500': [300, 500], '500-1500': [500, 1500], '1500-3000': [1500, 3000],
        '3000-5000': [3000, 5000], '5000+': [5000, 8000]
      };
      let [low, high] = budgetRange[data.budget] || [1000, 2500];
      let complexity = scopeItems.length;
      if (complexity <= 3) { /* keep low */ }
      else if (complexity <= 5) { low *= 1.2; high *= 1.2; }
      else { low *= 1.5; high *= 1.5; }
      low = Math.round(low / 50) * 50;
      high = Math.round(high / 50) * 50;
      if (low > high) [low, high] = [high, low];

      let recommendations = [];
      if (data.existingSite === 'yes') recommendations.push('We can redesign/upgrade your current site for better performance.');
      if (data.goals.includes('leads')) recommendations.push('We’ll implement lead capture forms and CTAs.');
      if (data.goals.includes('sell')) recommendations.push('We’ll integrate secure payment gateways.');
      if (data.goals.includes('bookings')) recommendations.push('We’ll set up a fully automated booking system.');
      if (data.budget === '<500' && complexity > 3) recommendations.push('Consider a phased approach to stay within budget.');
      if (data.flexible === 'yes') recommendations.push('We can propose additional features to maximize ROI.');

      return {
        scope: scopeItems,
        timeline: timelineText,
        budget: `$${low} – $${high}`,
        recommendations: recommendations.length ? recommendations : ['We’ll tailor everything to your specific needs.'],
        summary: `Based on your requirements for ${data.bizName}, we recommend a comprehensive solution including ${scopeItems.join(', ')}.`
      };
    }

    function displayProposal(proposal) {
      const resultDiv = document.getElementById('proposalResult');
      const content = document.getElementById('proposalContent');
      let html = `
        <div style="margin-bottom:15px;"><p><strong>${proposal.summary}</strong></p></div>
        <div style="margin:15px 0;">
          <div class="proposal-item"><span class="label">Scope</span><span class="value">${proposal.scope.length} services</span></div>
          <ul style="color:rgba(255,255,255,0.9); padding-left:20px; margin:5px 0 15px;">
            ${proposal.scope.map(item => `<li>${item}</li>`).join('')}
          </ul>
          <div class="proposal-item"><span class="label">Estimated Timeline</span><span class="value">${proposal.timeline}</span></div>
          <div class="proposal-total"><span>Estimated Investment</span><span class="price">${proposal.budget}</span></div>
          <div style="margin-top:20px;">
            <p><strong>💡 Recommendations</strong></p>
            <ul style="color:rgba(255,255,255,0.9); padding-left:20px;">
              ${proposal.recommendations.map(r => `<li>${r}</li>`).join('')}
            </ul>
          </div>
        </div>
      `;
      content.innerHTML = html;
      resultDiv.style.display = 'block';
      matcherForm.style.display = 'none';
      resultDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Connect Matcher "Start Your Project" button
    document.getElementById('startOrderFromMatcher').addEventListener('click', function() {
      // Close matcher, open order modal (default to business for now, or we can let user pick)
      matcherOverlay.classList.remove('active');
      document.body.style.overflow = '';
      setTimeout(() => {
        openOrderModal('business');
      }, 300);
    });

    // =============================================================
    // 6. AI CHATBOT
    // =============================================================
    const chatToggle = document.getElementById('customChatToggle');
    const chatWidget = document.getElementById('customChatWidget');
    const closeChat = document.getElementById('closeChatBtn');
    const chatMessages = document.getElementById('chatMessages');
    const chatInput = document.getElementById('chatInput');
    const chatSend = document.getElementById('chatSendBtn');

    const knowledgeBase = [
      { keywords: ['hello', 'hi', 'hey'], response: "Hello! How can I assist you today? 😊" },
      { keywords: ['price', 'cost', 'how much'], response: "Our prices vary based on scope. I recommend using our <strong>Smart Planner</strong> for a custom quote – just type 'proposal'!" },
      { keywords: ['timeline', 'how long', 'time'], response: "Project timelines depend on complexity. Typically, a standard website takes 3‑6 weeks. Use the Smart Planner for a more accurate estimate." },
      { keywords: ['web design', 'website'], response: "We offer professional web design for businesses of all sizes. Our Smart Planner can help you choose the right package." },
      { keywords: ['copywriting', 'content'], response: "Yes! We provide expert copywriting services. Our Smart Planner includes copywriting as an option." },
      { keywords: ['google business', 'gmb', 'local seo'], response: "We optimize Google Business Profiles to boost local visibility. We can include this in your proposal." },
      { keywords: ['ecommerce', 'shop', 'sell'], response: "We build custom e‑commerce stores. The Smart Planner will ask about your product needs." },
      { keywords: ['booking', 'appointment'], response: "We can integrate booking systems. Let the Smart Planner know you need it." },
      { keywords: ['support', 'maintenance'], response: "We offer ongoing maintenance plans. You can select that option in the Smart Planner." },
      { keywords: ['proposal', 'estimate', 'quote'], response: "Great! Let's start the Smart Planner. Just type 'open' and I'll launch it." },
      { keywords: ['open', 'launch', 'start'], response: "Opening the Smart Planner for you..." }
    ];

    function getBotResponse(input) {
      const lower = input.toLowerCase();
      for (let entry of knowledgeBase) {
        for (let kw of entry.keywords) {
          if (lower.includes(kw)) {
            if (kw === 'open' || kw === 'launch' || kw === 'start') {
              setTimeout(() => { document.getElementById('openMatcherBtn').click(); }, 400);
              return entry.response + " (the planner will open in a moment)";
            }
            return entry.response;
          }
        }
      }
      return "I'm not sure I understand. You can ask about our services, pricing, timeline, or type 'proposal' to get a custom plan. 😊";
    }

    function addMessage(text, sender) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `chat-message ${sender}`;
      msgDiv.innerHTML = text;
      chatMessages.appendChild(msgDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function handleChatSend() {
      const msg = chatInput.value.trim();
      if (!msg) return;
      addMessage(msg, 'user');
      chatInput.value = '';
      setTimeout(() => { addMessage(getBotResponse(msg), 'bot'); }, 300);
    }

    chatSend.addEventListener('click', handleChatSend);
    chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleChatSend(); });
    chatToggle.addEventListener('click', () => { chatWidget.classList.toggle('open'); });
    closeChat.addEventListener('click', () => { chatWidget.classList.remove('open'); });

    if (document.getElementById('ecommerce').value === 'no') {
      document.getElementById('productCountGroup').style.display = 'none';
    }
    console.log('🚀 Smart Matcher, Service Details, Order Flow & AI Chatbot loaded successfully!');
  </script>

