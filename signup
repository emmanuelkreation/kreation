<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <meta name="description" content="Create your Kreation Digital Hub account to access premium services and tools." />
  <meta name="keywords" content="sign up, create account, Kreation Digital Hub, digital services" />
  <meta name="author" content="Kreation Digital Hub" />
  <title>Create Account | Kreation Digital Hub</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Consistent with homepage CSS variables and base styles */
    :root {
      --primary: #003333;
      --secondary: #39FF14;
      --accent: #00CC99;
      --dark: #000000;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-start: #001a1a;
      --gradient-end: #004d4d;
      --neon-glow: 0 0 10px rgba(57, 255, 20, 0.7),
                   0 0 20px rgba(57, 255, 20, 0.5),
                   0 0 30px rgba(57, 255, 20, 0.3);
      --card-bg: rgba(0, 51, 51, 0.3);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

 html, body {
  width: 100%;
  overflow-x: hidden;
  overflow-y: auto;
}



    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Montserrat', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .signup-wrapper {
      display: flex;
      min-height: 100%;
      width: 100%;
    }

    /* Left side - Branding & Info */
    .signup-left {
      flex: 1;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 50%, var(--gradient-end) 100%);
      padding: 3rem 4rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      overflow: hidden;
      overflow-y: auto; /* Allow scrolling on left side if needed */
    }

    .signup-left::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0,0 L100,0 L100,100 Z" fill="rgba(57,255,20,0.03)"/></svg>');
      background-size: cover;
      z-index: 0;
    }

    .logo {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--light);
      font-family: 'Montserrat', sans-serif;
      margin-bottom: 3rem;
      position: relative;
      z-index: 1;
    }

    .logo span {
      color: var(--secondary);
      position: relative;
    }

    .logo span::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .signup-left-content {
      max-width: 600px;
      position: relative;
      z-index: 1;
    }

    .signup-left h1 {
      font-size: 3.2rem;
      line-height: 1.2;
      margin-bottom: 2rem;
      color: var(--light);
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .signup-left h1 span {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .signup-left p {
      font-size: 1.2rem;
      margin-bottom: 2.5rem;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 400;
      max-width: 500px;
    }

    .benefits-list {
      list-style: none;
      margin-top: 2.5rem;
    }

    .benefits-list li {
      display: flex;
      align-items: center;
      margin-bottom: 1.5rem;
      font-size: 1.1rem;
    }

    .benefits-list i {
      color: var(--secondary);
      margin-right: 1rem;
      font-size: 1.3rem;
      text-shadow: var(--neon-glow);
    }

    .tech-element {
      position: absolute;
      width: 100px;
      height: 100px;
      border: 2px solid rgba(57, 255, 20, 0.5);
      border-radius: 10px;
      box-shadow: var(--neon-glow);
      animation: rotate 20s linear infinite;
      z-index: 0;
    }

    .tech-element-1 {
      top: 20%;
      right: 10%;
      width: 120px;
      height: 120px;
      animation-duration: 25s;
    }

    .tech-element-2 {
      bottom: 30%;
      left: 5%;
      width: 80px;
      height: 80px;
      animation-duration: 15s;
      animation-direction: reverse;
    }

    @keyframes rotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Right side - Signup Form - FIXED FOR SCROLLING */
   .signup-right {
  flex: 1;
  display: block;   /* IMPORTANT */
  background: rgba(0, 0, 0, 0.95);
  padding: 2rem;
  min-height: 100%;
  overflow-y: visible;
}



    .signup-container {
      width: 100%;
      max-width: 550px;
      padding: 2.5rem;
      background: var(--card-bg);
      border-radius: 20px;
      border: 1px solid rgba(57, 255, 20, 0.2);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      position: relative;
      overflow: hidden;
      margin: 2rem auto; /* Center vertically when content fits */
    }

    .signup-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, var(--secondary), var(--accent));
      transform-origin: left;
    }

    .signup-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .signup-header h2 {
      font-size: 2.2rem;
      color: var(--light);
      margin-bottom: 0.5rem;
      font-weight: 700;
      font-family: 'Montserrat', sans-serif;
    }

    .signup-header h2 span {
      color: var(--secondary);
    }

    .signup-header p {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1rem;
    }

    .signup-form {
      width: 100%;
    }

    .form-group {
      margin-bottom: 1.5rem;
      position: relative;
    }

    .form-label {
      display: block;
      margin-bottom: 0.5rem;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 500;
      font-size: 0.95rem;
    }

    .input-with-icon {
      position: relative;
    }

    .form-control {
      width: 100%;
      padding: 1rem 1.2rem 1rem 3rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(57, 255, 20, 0.3);
      border-radius: 10px;
      color: var(--light);
      font-family: inherit;
      font-size: 1rem;
      transition: all 0.3s;
    }

    .form-control:focus {
      border-color: var(--secondary);
      outline: none;
      box-shadow: 0 0 15px rgba(57, 255, 20, 0.3);
      background: rgba(255, 255, 255, 0.08);
    }

    .input-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--secondary);
      font-size: 1.1rem;
      z-index: 1;
    }

    .password-toggle {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--gray);
      cursor: pointer;
      font-size: 1.1rem;
      transition: color 0.3s;
    }

    .password-toggle:hover {
      color: var(--secondary);
    }

    .terms-checkbox {
      display: flex;
      align-items: flex-start;
      margin-bottom: 1.5rem;
      gap: 0.8rem;
    }

    .terms-checkbox input {
      margin-top: 0.2rem;
      accent-color: var(--secondary);
      transform: scale(1.1);
    }

    .terms-checkbox label {
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .terms-checkbox a {
      color: var(--secondary);
      text-decoration: none;
      transition: all 0.3s;
    }

    .terms-checkbox a:hover {
      text-shadow: var(--neon-glow);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: var(--light);
      padding: 1rem 2rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.4s;
      border: 2px solid var(--secondary);
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
      width: 100%;
      font-size: 1rem;
      cursor: pointer;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: var(--secondary);
      transition: all 0.4s;
      z-index: -1;
    }

    .btn:hover {
      color: var(--dark);
      transform: translateY(-3px);
    }

    .btn:hover::before {
      width: 100%;
    }

    .btn i {
      margin-right: 0.8rem;
      font-size: 1.1rem;
    }

    .divider {
      display: flex;
      align-items: center;
      margin: 1.5rem 0;
      color: rgba(255, 255, 255, 0.6);
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(57, 255, 20, 0.3);
    }

    .divider span {
      padding: 0 1rem;
      font-size: 0.85rem;
    }

    .social-signup {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .social-btn {
      flex: 1;
      padding: 0.8rem;
      border-radius: 10px;
      border: 1px solid rgba(57, 255, 20, 0.3);
      background: rgba(255, 255, 255, 0.05);
      color: var(--light);
      font-family: inherit;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.95rem;
    }

    .social-btn:hover {
      border-color: var(--secondary);
      background: rgba(57, 255, 20, 0.1);
      transform: translateY(-3px);
    }

    .social-btn i {
      font-size: 1.1rem;
    }

    /* ✅ IMPROVED LOGIN LINK SECTION */
    .login-prompt {
      text-align: center;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
    }

    .login-prompt p {
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
    }

    .login-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      color: var(--secondary);
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
      padding: 0.5rem 1.5rem;
      border-radius: 50px;
      border: 1px solid rgba(57, 255, 20, 0.3);
      transition: all 0.3s;
    }

    .login-link i {
      font-size: 1rem;
    }

    .login-link:hover {
      background: rgba(57, 255, 20, 0.1);
      border-color: var(--secondary);
      box-shadow: var(--neon-glow);
      transform: translateY(-2px);
    }

    .error-message {
      color: #ff6b6b;
      font-size: 0.85rem;
      margin-top: 0.3rem;
      display: none;
    }

    .success-message {
      color: var(--secondary);
      font-size: 0.9rem;
      margin-top: 0.5rem;
      display: none;
      text-align: center;
    }

    /* Footer */
    .signup-footer {
      text-align: center;
      padding: 1.5rem 0 0;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.85rem;
      margin-top: 1rem;
    }

    .signup-footer a {
      color: var(--secondary);
      text-decoration: none;
      transition: all 0.3s;
    }

    .signup-footer a:hover {
      text-shadow: var(--neon-glow);
    }

    /* ✅ IMPROVED RESPONSIVE DESIGN WITH SCROLLING */
    @media (max-width: 1200px) {
      .signup-left h1 {
        font-size: 2.8rem;
      }
      
      .signup-left {
        padding: 2.5rem;
      }
      
      .signup-right {
        padding: 2rem;
      }
    }

    @media (max-width: 992px) {
      .signup-wrapper {
        flex-direction: column;
      }
      
      .signup-left,
      .signup-right {
        flex: none;
        width: 100%;
        padding: 2.5rem;
      }
      
      .signup-left {
        min-height: auto;
        padding-bottom: 2rem;
      }
      
      .signup-left-content {
        max-width: 100%;
      }
      
      .signup-left h1 {
        font-size: 2.5rem;
      }
      
      .signup-right {
        height: auto; /* Reset height for mobile */
        min-height: auto;
        overflow-y: visible; /* Reset overflow for mobile */
      }
      
      .signup-container {
        margin: 0 auto; /* Remove auto margin on mobile */
      }
    }

    @media (max-width: 768px) {
      .signup-left,
      .signup-right {
        padding: 2rem;
      }
      
      .signup-container {
        padding: 2rem;
      }
      
      .signup-header h2 {
        font-size: 2rem;
      }
      
      .social-signup {
        flex-direction: column;
      }
      
      .signup-left h1 {
        font-size: 2.2rem;
      }
      
      .logo {
        font-size: 2rem;
        margin-bottom: 2rem;
      }
      
      .benefits-list li {
        font-size: 1rem;
        margin-bottom: 1rem;
      }
      
      .signup-right {
        padding: 1.5rem;
      }
    }

    @media (max-width: 576px) {
      .signup-left,
      .signup-right {
        padding: 1.5rem;
      }
      
      .signup-container {
        padding: 1.5rem;
      }
      
      .signup-left h1 {
        font-size: 2rem;
      }
      
      .signup-left p {
        font-size: 1rem;
      }
      
      .form-control {
        padding: 0.9rem 1rem 0.9rem 2.8rem;
        font-size: 0.95rem;
      }
      
      .input-icon {
        left: 0.9rem;
        font-size: 1rem;
      }
      
      .signup-header h2 {
        font-size: 1.8rem;
      }
      
      .tech-element {
        display: none;
      }
    }

    @media (max-width: 480px) {
      .signup-left h1 {
        font-size: 1.8rem;
      }
      
      .logo {
        font-size: 1.6rem;
      }
      
      .signup-header h2 {
        font-size: 1.6rem;
      }
      
      .signup-container {
        padding: 1.2rem;
      }
      
      .btn {
        padding: 0.9rem 1.5rem;
      }
      
      .terms-checkbox label {
        font-size: 0.85rem;
      }
    }

    /* ✅ LARGE PC SCREENS - WITH PROPER SCROLLING */
    @media (min-width: 1400px) {
      .signup-container {
        max-width: 600px;
        padding: 3rem;
      }
      
      .signup-left {
        padding: 4rem;
      }
      
      .signup-right {
        padding: 2rem 3rem;
      }
      
      .signup-left h1 {
        font-size: 3.5rem;
      }
    }

    /* ✅ CUSTOM SCROLLBAR STYLING */
    .signup-right::-webkit-scrollbar {
      width: 8px;
    }

    .signup-right::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.3);
    }

    .signup-right::-webkit-scrollbar-thumb {
      background: var(--secondary);
      border-radius: 10px;
      box-shadow: var(--neon-glow);
    }

    .signup-right::-webkit-scrollbar-thumb:hover {
      background: var(--accent);
    }
  </style>
</head>
<body>
  <div class="signup-wrapper">
    <!-- Left side - Branding & Info -->
    <div class="signup-left">
      <div class="logo">Kreation <span>Digital</span>Hub</div>
      <div class="signup-left-content">
        <h1>Join <span>Kreation Digital Hub</span></h1>
        <p>Create your account to access premium web design, copywriting, and Google Business Profile optimization services tailored for entrepreneurs, SMEs, and real estate firms.</p>
        
        <ul class="benefits-list">
          <li><i class="fas fa-check-circle"></i> Access to premium digital services</li>
          <li><i class="fas fa-check-circle"></i> Track your project progress</li>
          <li><i class="fas fa-check-circle"></i> Download resources & templates</li>
          <li><i class="fas fa-check-circle"></i> Get exclusive client discounts</li>
          <li><i class="fas fa-check-circle"></i> Priority customer support</li>
        </ul>
      </div>
      
      <div class="tech-element tech-element-1"></div>
      <div class="tech-element tech-element-2"></div>
    </div>
    
    <!-- Right side - Signup Form - NOW SCROLLABLE ON PC -->
    <div class="signup-right">
      <div class="signup-container">
        <div class="signup-header">
          <h2>Create <span>Account</span></h2>
          <p>Sign up to get started with Kreation Digital Hub</p>
        </div>
        
        <form class="signup-form" id="signupForm">
          <div class="form-group">
            <label class="form-label" for="fullName">Full Name</label>
            <div class="input-with-icon">
              <i class="fas fa-user input-icon"></i>
              <input type="text" id="fullName" class="form-control" placeholder="Enter your full name" required>
            </div>
            <div class="error-message" id="nameError"></div>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="email">Email Address</label>
            <div class="input-with-icon">
              <i class="fas fa-envelope input-icon"></i>
              <input type="email" id="email" class="form-control" placeholder="Enter your email" required>
            </div>
            <div class="error-message" id="emailError"></div>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <div class="input-with-icon">
              <i class="fas fa-lock input-icon"></i>
              <input type="password" id="password" class="form-control" placeholder="Create a strong password" required>
              <button type="button" class="password-toggle" id="togglePassword">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <div class="error-message" id="passwordError"></div>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm Password</label>
            <div class="input-with-icon">
              <i class="fas fa-lock input-icon"></i>
              <input type="password" id="confirmPassword" class="form-control" placeholder="Confirm your password" required>
              <button type="button" class="password-toggle" id="toggleConfirmPassword">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <div class="error-message" id="confirmPasswordError"></div>
          </div>
          
          <div class="terms-checkbox">
            <input type="checkbox" id="terms" required>
            <label for="terms">
              I agree to the <a href="#" target="_blank">Terms of Service</a> and <a href="#" target="_blank">Privacy Policy</a>. I understand that Kreation Digital Hub may contact me regarding services.
            </label>
          </div>
          
          <button type="submit" class="btn" id="signupBtn">
            <i class="fas fa-user-plus"></i> Create Account
          </button>
          <div class="success-message" id="successMessage"></div>
          
          <div class="divider">
            <span>Or sign up with</span>
          </div>
          
          <div class="social-signup">
            <!-- UPDATED: Google Sign-In Button with ID -->
            <button type="button" class="social-btn" id="googleSignInBtn">
              <i class="fab fa-google"></i> Google
            </button>
            <!-- Keep LinkedIn for future use -->
            <button type="button" class="social-btn" id="linkedInBtn">
              <i class="fab fa-linkedin"></i> LinkedIn
            </button>
          </div>
          
          <!-- ✅ LOGIN SECTION -->
          <div class="login-prompt">
            <p>Already have an account?</p>
            <a href="login" class="login-link">
              <i class="fas fa-sign-in-alt"></i> Login Here
            </a>
          </div>
        </form>
        
        <div class="signup-footer">
          <p>By creating an account, you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.</p>
          <p>&copy; 2025 Kreation Digital Hub. All rights reserved.</p>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
  // ===== UPDATED IMPORTS with Google Auth =====
  import { initializeApp } from "https://www.gstatic.com/firebasejs/9.22.1/firebase-app.js";
  import { 
    getAuth, 
    createUserWithEmailAndPassword,
    signInWithPopup,
    GoogleAuthProvider
  } from "https://www.gstatic.com/firebasejs/9.22.1/firebase-auth.js";
  
  // ✅ CORRECT Firebase configuration
  const firebaseConfig = {
    apiKey: "AIzaSyDLrhVKnl60WcRYkpFEvDvy3-u5_WX-rCo",
    authDomain: "reviews-d3d7a.firebaseapp.com",
    databaseURL: "https://reviews-d3d7a-default-rtdb.firebaseio.com",
    projectId: "reviews-d3d7a",
    storageBucket: "reviews-d3d7a.firebasestorage.app",
    messagingSenderId: "134697578964",
    appId: "1:134697578964:web:813ec1b41efaa270512641"
  };
  
  // Initialize Firebase
  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  
  console.log("✅ Firebase initialized with CORRECT API key");
  
  // DOM Elements
  const signupForm = document.getElementById('signupForm');
  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');
  const confirmPasswordInput = document.getElementById('confirmPassword');
  const fullNameInput = document.getElementById('fullName');
  const signupBtn = document.getElementById('signupBtn');
  const togglePasswordBtn = document.getElementById('togglePassword');
  const toggleConfirmPasswordBtn = document.getElementById('toggleConfirmPassword');
  const googleSignInBtn = document.getElementById('googleSignInBtn');
  const linkedInBtn = document.getElementById('linkedInBtn');
  
  // Error/Success message elements
  const emailError = document.getElementById('emailError');
  const passwordError = document.getElementById('passwordError');
  const confirmPasswordError = document.getElementById('confirmPasswordError');
  const nameError = document.getElementById('nameError');
  const successMessage = document.getElementById('successMessage');
  
  // Password visibility toggle
  togglePasswordBtn.addEventListener('click', function() {
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    this.querySelector('i').classList.toggle('fa-eye');
    this.querySelector('i').classList.toggle('fa-eye-slash');
  });
  
  toggleConfirmPasswordBtn.addEventListener('click', function() {
    const type = confirmPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    confirmPasswordInput.setAttribute('type', type);
    this.querySelector('i').classList.toggle('fa-eye');
    this.querySelector('i').classList.toggle('fa-eye-slash');
  });
  
  // Form validation
  function validateForm() {
    let isValid = true;
    
    // Clear previous error messages
    emailError.style.display = 'none';
    passwordError.style.display = 'none';
    confirmPasswordError.style.display = 'none';
    nameError.style.display = 'none';
    
    // Name validation
    if (!fullNameInput.value.trim()) {
      nameError.textContent = 'Full name is required';
      nameError.style.display = 'block';
      isValid = false;
    }
    
    // Email validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailInput.value.trim()) {
      emailError.textContent = 'Email is required';
      emailError.style.display = 'block';
      isValid = false;
    } else if (!emailRegex.test(emailInput.value)) {
      emailError.textContent = 'Please enter a valid email address';
      emailError.style.display = 'block';
      isValid = false;
    }
    
    // Password validation
    if (!passwordInput.value) {
      passwordError.textContent = 'Password is required';
      passwordError.style.display = 'block';
      isValid = false;
    } else if (passwordInput.value.length < 6) {
      passwordError.textContent = 'Password must be at least 6 characters';
      passwordError.style.display = 'block';
      isValid = false;
    }
    
    // Confirm password validation
    if (!confirmPasswordInput.value) {
      confirmPasswordError.textContent = 'Please confirm your password';
      confirmPasswordError.style.display = 'block';
      isValid = false;
    } else if (passwordInput.value !== confirmPasswordInput.value) {
      confirmPasswordError.textContent = 'Passwords do not match';
      confirmPasswordError.style.display = 'block';
      isValid = false;
    }
    
    return isValid;
  }
  
  // Email/Password form submission
  signupForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    if (!validateForm()) return;
    
    // Disable button and show loading state
    signupBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating Account...';
    signupBtn.disabled = true;
    
    try {
      console.log("Attempting to create user:", emailInput.value);
      
      // Firebase authentication
      const userCredential = await createUserWithEmailAndPassword(
        auth, 
        emailInput.value, 
        passwordInput.value
      );
      
      console.log("✅ Account created successfully!", userCredential.user.email);
      
      // Success - show message and redirect
      successMessage.textContent = 'Account created successfully! Redirecting to dashboard...';
      successMessage.style.display = 'block';
      
      // You can save additional user data to Firestore here
      
      // Redirect after 2 seconds
      setTimeout(() => {
        window.location.href = "dashboard";
      }, 2000);
      
    } catch (error) {
      console.error('❌ Firebase error:', error.code, error.message);
      
      // Reset button
      signupBtn.innerHTML = '<i class="fas fa-user-plus"></i> Create Account';
      signupBtn.disabled = false;
      
      let errorMessage = 'An error occurred. Please try again.';
      
      switch (error.code) {
        case 'auth/email-already-in-use':
          errorMessage = 'This email is already registered. Please sign in instead.';
          emailError.textContent = errorMessage;
          emailError.style.display = 'block';
          break;
        case 'auth/invalid-email':
          errorMessage = 'Invalid email address.';
          emailError.textContent = errorMessage;
          emailError.style.display = 'block';
          break;
        case 'auth/weak-password':
          errorMessage = 'Password is too weak. Use at least 6 characters.';
          passwordError.textContent = errorMessage;
          passwordError.style.display = 'block';
          break;
        case 'auth/operation-not-allowed':
          errorMessage = 'Email/password signup is not enabled. Please enable it in Firebase Console.';
          alert(errorMessage);
          break;
        default:
          alert('Error: ' + error.message);
      }
    }
  });
  
  // ===== NEW: GOOGLE SIGN-IN FUNCTIONALITY =====
  // Create Google Auth Provider
  const googleProvider = new GoogleAuthProvider();
  
  // Optional: Add custom parameters
  googleProvider.setCustomParameters({
    'prompt': 'select_account' // Forces account selection
  });
  
  // Add click handler for Google Sign-In
  googleSignInBtn.addEventListener('click', async () => {
    try {
      console.log("🚀 Starting Google sign-in...");
      
      // Show loading state
      googleSignInBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Connecting...';
      googleSignInBtn.disabled = true;
      
      // Trigger Google sign-in popup
      const result = await signInWithPopup(auth, googleProvider);
      
      // Success! User is signed in
      console.log("✅ Google sign-in successful!", result.user.email);
      console.log("User display name:", result.user.displayName);
      
      // Get Google access token (optional)
      const credential = GoogleAuthProvider.credentialFromResult(result);
      const token = credential.accessToken;
      console.log("🔑 Access token received");
      
      // Here you could save user data to Firestore
      // await saveUserToFirestore(result.user);
      
      // Show success message
      successMessage.textContent = 'Signed in with Google successfully! Redirecting...';
      successMessage.style.display = 'block';
      
      // Redirect to dashboard
      setTimeout(() => {
        window.location.href = "dashboard";
      }, 2000);
      
    } catch (error) {
      console.error('❌ Google sign-in error:', error.code, error.message);
      
      // Reset button
      googleSignInBtn.innerHTML = '<i class="fab fa-google"></i> Google';
      googleSignInBtn.disabled = false;
      
      // Handle specific errors
      switch (error.code) {
        case 'auth/popup-closed-by-user':
          // User closed the popup - don't show error
          console.log('Popup closed by user');
          break;
        case 'auth/popup-blocked':
          alert('Popup was blocked by your browser. Please allow popups for this site.');
          break;
        case 'auth/cancelled-popup-request':
          // Another popup already open - ignore
          break;
        case 'auth/account-exists-with-different-credential':
          alert('An account already exists with the same email address but different sign-in method. Please sign in using the method you used originally.');
          break;
        default:
          alert('Google sign-in failed: ' + error.message);
      }
    }
  });
  
  // LinkedIn button (placeholder for now)
  if (linkedInBtn) {
    linkedInBtn.addEventListener('click', function() {
      alert('LinkedIn sign-in coming soon! Please use Google or email signup for now.');
    });
  }
  
  // Input validation on the fly
  emailInput.addEventListener('blur', () => {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (emailInput.value && !emailRegex.test(emailInput.value)) {
      emailError.textContent = 'Please enter a valid email address';
      emailError.style.display = 'block';
    } else {
      emailError.style.display = 'none';
    }
  });
  
  passwordInput.addEventListener('input', () => {
    if (passwordInput.value.length > 0 && passwordInput.value.length < 6) {
      passwordError.textContent = 'Password must be at least 6 characters';
      passwordError.style.display = 'block';
    } else {
      passwordError.style.display = 'none';
    }
  });
  
  confirmPasswordInput.addEventListener('input', () => {
    if (confirmPasswordInput.value && passwordInput.value !== confirmPasswordInput.value) {
      confirmPasswordError.textContent = 'Passwords do not match';
      confirmPasswordError.style.display = 'block';
    } else {
      confirmPasswordError.style.display = 'none';
    }
  });
  </script>
