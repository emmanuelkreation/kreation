<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Meet the talented team behind Kreation Digital Hub - Web Design and Copywriting experts." />
  <meta name="keywords" content="Web Development Team, Creative Team Nigeria, Web Design Professionals" />
  <meta name="author" content="Kreation Digital Hub" />
  
  <title>Our Team | Kreation Digital Hub</title>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon" href="favicon.jpg" type="image/jpg">
  
  <style>
    :root {
      --primary: #003333;
      --secondary: #39FF14;
      --accent: #00CC99;
      --dark: #000000;
      --light: #FFFFFF;
      --gray: #AAAAAA;
      --gradient-start: #001a1a;
      --gradient-end: #004d4d;
      --neon-glow: 0 0 10px rgba(57, 255, 20, 0.7),
                   0 0 20px rgba(57, 255, 20, 0.5),
                   0 0 30px rgba(57, 255, 20, 0.3);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
      position: relative;
      width: 100%;
    }

    body {
      background: var(--dark);
      color: var(--light);
      line-height: 1.6;
      font-family: 'Inter', 'Montserrat', sans-serif;
      position: relative;
      width: 100%;
      min-height: 100vh;
      -webkit-text-size-adjust: 100%;
      -webkit-overflow-scrolling: touch;
    }

    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .gradient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--gradient-start) 0%, var(--dark) 50%, var(--gradient-end) 100%);
      opacity: 0.9;
      z-index: -3;
    }

    /* Header & Navigation */
    header {
      background: rgba(0, 0, 0, 0.95);
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(57, 255, 20, 0.2);
      transition: all 0.3s ease;
      width: 100%;
      left: 0;
      right: 0;
    }

    header.scrolled {
      padding: 0.8rem 2rem;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--light);
      font-family: 'Montserrat', sans-serif;
      display: flex;
      align-items: center;
      z-index: 1002;
    }

    .logo span {
      color: var(--secondary);
      position: relative;
    }

    .logo span::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--light);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      position: relative;
      padding: 0.5rem 0;
      font-family: 'Montserrat', sans-serif;
      letter-spacing: 0.5px;
      font-size: 0.95rem;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--secondary);
      transition: width 0.3s;
      box-shadow: var(--neon-glow);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: var(--light);
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 1001;
    }

    /* Hero Section */
    .hero {
      padding: 8rem 2rem 5rem;
      min-height: 60vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), 
                  url('https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80');
      background-size: cover;
      background-position: center;
      text-align: center;
      width: 100%;
    }

    .hero-content {
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }

    .hero-text h1 {
      font-size: 3.5rem;
      line-height: 1.2;
      margin-bottom: 1.5rem;
      color: var(--light);
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .hero-text h1 span {
      color: var(--secondary);
      text-shadow: var(--neon-glow);
    }

    .hero-text p {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      color: rgba(255, 255, 255, 0.9);
    }

    .btn-group {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: var(--light);
      padding: 1rem 2.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.4s;
      border: 2px solid var(--secondary);
      position: relative;
      overflow: hidden;
      z-index: 1;
      box-shadow: var(--neon-glow);
      font-family: 'Montserrat', sans-serif;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: var(--secondary);
      transition: all 0.4s;
      z-index: -1;
    }

    .btn:hover {
      color: var(--dark);
      transform: translateY(-5px);
    }

    .btn:hover::before {
      width: 100%;
    }

    .btn-secondary {
      background: transparent;
      color: var(--secondary);
    }

    .btn-secondary:hover {
      color: var(--dark);
    }

    /* Sections */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      width: 100%;
      overflow: hidden;
    }

    .section {
      padding: 6rem 0;
      position: relative;
      width: 100%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 5rem;
      width: 100%;
    }

    .section-title h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
    }

    .section-title h2 span {
      color: var(--secondary);
    }

    .section-title h2::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 4px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .section-title p {
      max-width: 700px;
      margin: 2rem auto 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
      line-height: 1.6;
    }

    /* Card Styles */
    .card {
      background: rgba(0, 51, 51, 0.3);
      border-radius: 15px;
      padding: 2.5rem;
      transition: all 0.4s;
      height: 100%;
      border: 1px solid rgba(57, 255, 20, 0.2);
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, var(--secondary), var(--accent));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s;
    }

    .card:hover {
      transform: translateY(-10px);
      border-color: rgba(57, 255, 20, 0.4);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    }

    .card:hover::before {
      transform: scaleX(1);
    }

    /* Team Section */
    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2.5rem;
      width: 100%;
    }

    .team-member {
      text-align: center;
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    .member-img {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid var(--secondary);
      margin: 0 auto 1.5rem;
      transition: all 0.4s;
      box-shadow: var(--neon-glow);
      max-width: 100%;
    }

    .team-member:hover .member-img {
      transform: scale(1.05);
    }

    .team-member h3 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
      color: var(--light);
      font-weight: 700;
    }

    .position {
      color: var(--secondary);
      font-weight: 500;
      margin-bottom: 1rem;
      display: block;
      font-size: 1.1rem;
    }

    .member-info {
      margin-bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1rem;
      line-height: 1.7;
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      width: 100%;
    }

    .skill-tag {
      background: rgba(57, 255, 20, 0.15);
      color: var(--secondary);
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .social-links {
      display: flex;
      justify-content: center;
      gap: 1rem;
      width: 100%;
    }

    .social-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--light);
      transition: all 0.3s;
      font-size: 1.2rem;
    }

    .social-links a:hover {
      background: var(--secondary);
      color: var(--dark);
      transform: translateY(-5px);
      box-shadow: var(--neon-glow);
    }

    /* Values Section */
    .values-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem;
      width: 100%;
    }

    .value-card {
      text-align: center;
      width: 100%;
    }

    .value-icon {
      font-size: 3rem;
      color: var(--secondary);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
    }

    .value-icon::after {
      content: '';
      position: absolute;
      width: 60px;
      height: 60px;
      background: rgba(57, 255, 20, 0.1);
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: -1;
    }

    .value-card h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--light);
      font-weight: 700;
    }

    .value-card p {
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.8;
    }

    /* CTA Section */
    .cta-section {
      background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), 
                  url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80');
      background-size: cover;
      background-position: center;
      padding: 6rem 2rem;
      text-align: center;
      border-radius: 15px;
      width: 100%;
    }

    .cta-section h2 {
      font-size: 2.8rem;
      color: var(--light);
      margin-bottom: 1.5rem;
    }

    .cta-section p {
      max-width: 700px;
      margin: 0 auto 2rem;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
    }

    /* Footer */
    footer {
      background: rgba(0, 0, 0, 0.95);
      padding: 5rem 0 2rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
      width: 100%;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 3rem;
      margin-bottom: 4rem;
      width: 100%;
    }

    .footer-col h4 {
      color: var(--light);
      margin-bottom: 1.5rem;
      font-size: 1.4rem;
      position: relative;
      padding-bottom: 0.8rem;
      font-weight: 700;
    }

    .footer-col h4::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 50px;
      height: 3px;
      background: var(--secondary);
      box-shadow: var(--neon-glow);
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      transition: all 0.3s;
      font-size: 1.1rem;
    }

    .footer-links a:hover {
      color: var(--secondary);
      transform: translateX(5px);
    }

    .social-links-footer {
      display: flex;
      gap: 1.2rem;
      margin-top: 1.5rem;
    }

    .social-links-footer a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--light);
      transition: all 0.3s;
      font-size: 1.2rem;
    }

    .social-links-footer a:hover {
      background: var(--secondary);
      color: var(--dark);
      transform: translateY(-5px);
      box-shadow: var(--neon-glow);
    }

    .copyright {
      text-align: center;
      padding-top: 3rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.1rem;
      width: 100%;
    }

    /* Scroll to top button */
    #scrollTopBtn {
      position: fixed;
      bottom: 40px;
      right: 40px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--secondary);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
      opacity: 0;
      visibility: hidden;
      z-index: 1000;
      box-shadow: var(--neon-glow);
      border: none;
    }

    #scrollTopBtn.show {
      opacity: 1;
      visibility: visible;
    }

    #scrollTopBtn:hover {
      transform: translateY(-5px) scale(1.1);
    }

    /* Chat Widget */
    .chat-widget {
      position: fixed;
      bottom: 30px;
      right: 30px;
      z-index: 999;
    }

    .chat-button {
      background: var(--secondary);
      color: var(--dark);
      border: none;
      border-radius: 50px;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      cursor: pointer;
      font-weight: 600;
      box-shadow: var(--neon-glow);
      transition: all 0.3s;
      font-size: 1rem;
      white-space: nowrap;
      z-index: 999;
    }

    .chat-button:hover {
      transform: translateY(-5px);
    }

    /* Enhanced Mobile Responsive Design */
    @media (max-width: 1200px) {
      .hero-text h1 {
        font-size: 3rem;
      }
    }

    @media (max-width: 992px) {
      .hero {
        padding: 7rem 2rem 4rem;
      }
      
      .section {
        padding: 5rem 0;
      }
      
      .mobile-menu-btn {
        display: block;
      }
      
      .nav-links {
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        background: rgba(0, 0, 0, 0.98);
        flex-direction: column;
        padding: 5rem 2rem 2rem;
        transition: right 0.3s ease;
        z-index: 1001;
        box-shadow: -5px 0 15px rgba(0, 0, 0, 0.5);
        margin: 0;
        overflow-y: auto;
      }
      
      .nav-links.active {
        right: 0;
      }
      
      .nav-links a {
        font-size: 1.2rem;
        padding: 1rem 0;
        display: block;
        border-bottom: 1px solid rgba(57, 255, 20, 0.1);
      }
      
      /* Close button for mobile menu */
      .nav-links::before {
        content: '\f00d';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        top: 1.5rem;
        right: 2rem;
        font-size: 1.5rem;
        color: var(--light);
        cursor: pointer;
        z-index: 1002;
      }

      /* Ensure main content doesn't shift when menu opens */
      body.menu-open {
        overflow: hidden;
        position: fixed;
        width: 100%;
      }
    }

    @media (max-width: 768px) {
      .nav-links {
        gap: 1rem;
      }

      .hero-text h1 {
        font-size: 2.5rem;
      }
      
      .hero-text p {
        font-size: 1.1rem;
      }
      
      .section-title h2 {
        font-size: 2.2rem;
      }
      
      .team-grid,
      .values-grid {
        grid-template-columns: 1fr;
      }
      
      .chat-button span {
        display: none;
      }
      
      .chat-button {
        padding: 1rem;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        justify-content: center;
      }

      /* Fix container padding on mobile */
      .container {
        padding: 0 1rem;
      }
      
      .card {
        padding: 2rem 1.5rem;
      }
      
      .btn {
        padding: 0.9rem 2rem;
        font-size: 0.95rem;
      }
    }

    @media (max-width: 576px) {
      header {
        padding: 1rem;
      }
      
      header.scrolled {
        padding: 0.8rem 1rem;
      }

      .nav-links {
        width: 100%;
        gap: 0.8rem;
      }

      .hero {
        padding: 6rem 1rem 3rem;
      }

      .hero-text h1 {
        font-size: 2.2rem;
      }
      
      .btn {
        width: 100%;
        justify-content: center;
      }
      
      .btn-group {
        flex-direction: column;
        gap: 1rem;
      }
      
      .footer-grid {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
      }
      
      .footer-col h4::after {
        left: 50%;
        transform: translateX(-50%);
      }
      
      .social-links-footer {
        justify-content: center;
      }
      
      .chat-widget {
        bottom: 20px;
        right: 20px;
      }
      
      .chat-button {
        padding: 0.8rem;
        width: 55px;
        height: 55px;
      }
      
      #scrollTopBtn {
        bottom: 90px; /* Adjusted to not overlap with chat widget */
        right: 20px;
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
      }

      /* Ensure no horizontal scrolling */
      .container {
        padding: 0 1rem;
        max-width: 100%;
        overflow: hidden;
      }
      
      .section {
        padding: 4rem 0;
      }
      
      .cta-section {
        padding: 4rem 1rem;
      }
      
      .cta-section h2 {
        font-size: 2.2rem;
      }
    }

    /* Prevent any overflow issues */
    @media (max-width: 480px) {
      html {
        -webkit-text-size-adjust: 100%;
      }
      
      body {
        -webkit-overflow-scrolling: touch;
      }
      
      .container {
        padding: 0 0.5rem;
      }
      
      .hero {
        padding: 5rem 0.5rem 2rem;
      }
      
      .member-img {
        width: 150px;
        height: 150px;
      }
      
      .skills {
        gap: 0.3rem;
      }
      
      .skill-tag {
        padding: 0.4rem 0.8rem;
        font-size: 0.8rem;
      }
    }

    /* Extra small devices */
    @media (max-width: 360px) {
      .logo {
        font-size: 1.5rem;
      }
      
      .hero-text h1 {
        font-size: 1.8rem;
      }
      
      .section-title h2 {
        font-size: 1.8rem;
      }
      
      .team-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }
    /* Dropdown parent */
.dropdown {
  position: relative;
}

/* Dropdown menu */
.dropdown-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background: white;
  list-style: none;
  padding: 10px 0;
  min-width: 180px;
  border-radius: 6px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  z-index: 999;
}

/* Show dropdown on hover */
.dropdown:hover .dropdown-menu {
  display: block;
}

/* Dropdown links */
.dropdown-menu li a {
  display: block;
  padding: 10px 20px;
  color: #333;
  text-decoration: none;
  white-space: nowrap;
}

.dropdown-menu li a:hover {
  background: #f1f1f1;
}

