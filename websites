        features: ['Property Search', 'Agent Portal', 'Booking System'],
        liveUrl: '#'
      },
      {
        id: 4,
        category: 'portfolio',
        title: 'Creative Agency Portfolio',
        description: 'Interactive portfolio website with case studies, client testimonials, and project showcases.',
        image: 'gallery/websites/agency-portfolio.jpg',
        badges: ['Portfolio', 'Interactive', 'Showcase'],
        features: ['Case Studies', 'Testimonials', 'Project Gallery'],
        liveUrl: '#'
      },
      {
        id: 5,
        category: 'business',
        title: 'Healthcare Clinic Website',
        description: 'Patient-focused healthcare website with appointment booking, doctor profiles, and service information.',
        image: 'gallery/websites/healthcare-clinic.jpg',
        badges: ['Healthcare', 'Appointments', 'Medical'],
        features: ['Booking System', 'Doctor Profiles', 'Service Info'],
        liveUrl: '#'
      },
      {
        id: 6,
        category: 'ecommerce',
        title: 'Fashion Boutique Online Store',
        description: 'Stylish fashion e-commerce website with product variations, size guides, and lookbook features.',
        image: 'gallery/websites/fashion-store.jpg',
        badges: ['Fashion', 'E-commerce', 'Stylish'],
        features: ['Product Variations', 'Size Guides', 'Lookbook'],
        liveUrl: '#'
      },
      {
        id: 7,
        category: 'portfolio',
        title: 'Photographer Portfolio',
        description: 'Visual portfolio website with gallery grid, lightbox features, and client booking system.',
        image: 'gallery/websites/photographer-portfolio.jpg',
        badges: ['Photography', 'Portfolio', 'Gallery'],
        features: ['Gallery Grid', 'Lightbox', 'Booking System'],
        liveUrl: '#'
      },
      {
        id: 8,
        category: 'business',
        title: 'Consulting Firm Website',
        description: 'Professional consulting website with service packages, client case studies, and resource library.',
        image: 'gallery/websites/consulting-firm.jpg',
        badges: ['Consulting', 'Professional', 'Case Studies'],
        features: ['Service Packages', 'Case Studies', 'Resource Library'],
        liveUrl: '#'
      }
    ];

    // Function to load website items
    function loadWebsiteItems(items) {
      const grid = document.getElementById('websiteGrid');
      grid.innerHTML = '';
      
      items.forEach((item, index) => {
        const websiteItem = document.createElement('div');
        websiteItem.className = `website-item animate ${item.category}`;
        websiteItem.setAttribute('data-category', item.category);
        websiteItem.style.animationDelay = `${index * 0.1}s`;
        
        websiteItem.innerHTML = `
          <div class="website-img-container">
            <img 
              src="${item.image}" 
              alt="${item.title}" 
              class="website-img"
              loading="lazy"
            >
          </div>
          <div class="website-content">
            <div class="website-badges">
              ${item.badges.map(badge => `<span class="website-badge">${badge}</span>`).join('')}
            </div>
            <h3 class="website-title">${item.title}</h3>
            <p class="website-description">${item.description}</p>
            <div class="website-features">
              ${item.features.map(feature => `
                <div class="website-feature">
                  <i class="fas fa-check-circle"></i>
                  <span>${feature}</span>
                </div>
              `).join('')}
            </div>
          </div>
        `;
        
        grid.appendChild(websiteItem);
        
        // Add click event to open live website
        websiteItem.addEventListener('click', () => {
          if (item.liveUrl && item.liveUrl !== '#') {
            window.open(item.liveUrl, '_blank');
          }
        });
      });
    }

    // Initialize website portfolio
    document.addEventListener('DOMContentLoaded', function() {
      // Load all website items
      loadWebsiteItems(websiteItems);
      
      // Initialize category filter
      initCategoryFilter();
      
      // Initialize functions
      initHeaderFunctions();
      initScrollToTop();
      initMobileMenu();
      initParticles();
    });

    // Category filter functionality
    function initCategoryFilter() {
      const categoryTabs = document.querySelectorAll('.category-tab');
      
      categoryTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          // Update active tab
          categoryTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          
          const category = tab.getAttribute('data-category');
          const websiteItemsAll = document.querySelectorAll('.website-item');
          
          // Filter items
          websiteItemsAll.forEach(item => {
            if (category === 'all' || item.getAttribute('data-category') === category) {
              item.style.display = 'block';
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
              }, 10);
            } else {
              item.style.opacity = '0';
              item.style.transform = 'translateY(20px)';
              setTimeout(() => {
                item.style.display = 'none';
              }, 300);
            }
          });
        });
      });
    }

    // Header scroll function
    function initHeaderFunctions() {
      const header = document.querySelector('header');
      if (header) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 100) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        });
      }
    }

    // Scroll to top function
    function initScrollToTop() {
      const scrollBtn = document.getElementById("scrollTopBtn");
      if (scrollBtn) {
        window.onscroll = () => {
          if (document.documentElement.scrollTop > 300) {
            scrollBtn.classList.add("show");
          } else {
            scrollBtn.classList.remove("show");
          }
        };

        scrollBtn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }
    }

    // Mobile menu function
    function initMobileMenu() {
      const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      const body = document.body;
      
      if (mobileMenuBtn && navLinks) {
        mobileMenuBtn.addEventListener('click', () => {
          navLinks.classList.toggle('active');
          body.classList.toggle('menu-open');
          
          const icon = mobileMenuBtn.querySelector('i');
          if (navLinks.classList.contains('active')) {
            icon.classList.remove('fa-bars');
            icon.classList.add('fa-times');
          } else {
            icon.classList.remove('fa-times');
            icon.classList.add('fa-bars');
          }
        });

        // Close mobile menu when clicking on a link
        document.querySelectorAll('.nav-links a').forEach(link => {
          link.addEventListener('click', () => {
            navLinks.classList.remove('active');
            body.classList.remove('menu-open');
            const icon = mobileMenuBtn.querySelector('i');
            icon.classList.remove('fa-times');
            icon.classList.add('fa-bars');
          });
        });
      }
    }

    // Particles.js configuration
    function initParticles() {
      particlesJS('particles-js', {
        "particles": {
          "number": { "value": 80, "density": { "enable": true, "value_area": 800 } },
          "color": { "value": "#39FF14" },
          "shape": { "type": "polygon", "stroke": { "width": 0, "color": "#000000" } },
          "opacity": { "value": 0.3, "random": true, "anim": { "enable": true, "speed": 1, "opacity_min": 0.1, "sync": false } },
          "size": { "value": 3, "random": true, "anim": { "enable": true, "speed": 3, "size_min": 0.1, "sync": false } },
          "line_linked": { "enable": true, "distance": 150, "color": "#39FF14", "opacity": 0.4, "width": 1 },
          "move": { "enable": true, "speed": 2, "direction": "none", "random": true, "straight": false, "out_mode": "out", "bounce": false }
        },
        "interactivity": {
          "detect_on": "canvas",
          "events": {
            "onhover": { "enable": true, "mode": "grab" },
            "onclick": { "enable": true, "mode": "push" },
            "resize": true
          },
          "modes": {
            "grab": { "distance": 140, "line_linked": { "opacity": 1 } },
            "push": { "particles_nb": 4 }
          }
        },
        "retina_detect": true
      });
    }
  </script>
