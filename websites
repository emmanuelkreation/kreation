      .website-cta h2 {
        font-size: 2.2rem;
      }
      
      .process-steps {
        flex-direction: column;
        gap: 2rem;
      }
    }
    
    @media (max-width: 576px) {
      .website-hero {
        padding: 5rem 1rem 2rem;
      }
      
      .website-hero h1 {
        font-size: 2.2rem;
      }
      
